// The button: a word in a hairline frame, for an action that happens where it
// stands.
//
// The palette's Copy buttons are the first (`UX-GUI-003`, `D98`). The palette's
// other click targets - the pack's name, the next band's heading, the link to
// the shortcuts window - are `PickerOpener`, a NAME that opens a window. A
// button differs from it in what it promises: it does its thing at once, where
// it stands, and the frame says so before the pointer arrives. A word in the
// palette's text colour cannot say that - `UX-GUI-015` is that complaint about
// the pack's name.
//
//     at rest          the word in the secondary text colour on a RAISED ground
//                      (`surface-raised`), the frame in `border`
//     pointer here     the frame in `border-strong`, the word in the accent
//     pressed          the ground sunk to `surface-sample`, the frame in the
//                      accent - the click is answered by the message band at
//                      once, so this lasts as long as the press
//
// ⚠️ The raised ground is a correction from the first render: with a frame and
// no ground, the button at rest was the twin of the `cleared first` marker a
// few lines below it - a status and an action told apart by nothing. A marker
// is drawn as an outline, so a button is not.
//     keyboard here    NEVER in the palette, on purpose: it refuses the keyboard
//                      focus (`D62`), and a focus ring that can never show is a
//                      state the gallery would have to fake. UI Automation
//                      reaches the button through its default action instead
//     cannot be used   faded as a whole (`alpha-disabled`), no pointer and no
//                      click - "no invitation" is the message (PORADNIK-GUI 10.9)
//
// A click reaches the palette without activating it (measured, `D62`), so the
// field under test keeps the keyboard.
//
// ⊕ `primary` - the ONE main action of a window (GUI rule 17), first the
// welcome window's "Start testing" (UX7): the ground in the accent and the word
// in the window's own ground colour, so it is the brightest thing on the screen
// before the pointer comes. Pointer and press move the frame, not the ground:
//
//     at rest          ground `accent`, word `surface`, frame `accent`
//     pointer here     frame `text-primary`
//     pressed          frame `text-primary`, ground `border-strong`
//
// Sized by its content, like `Pill`, whose frame and padding it shares: the
// width comes from a layout, never from arithmetic on the word - `Pill` says
// what the arithmetic did to the word "offensive".
//
// ⊕ `arrow` - a drawn triangle beside the word, for a button that steps through
// something (`D120`, the arrows that walk a pack): before the word for `back`,
// after it for `forward`. Drawn by `Chevron` rather than written as a character,
// because the interface's typeface is the system's and `◀` is not promised in
// it - and in the word's own colour, so the two answer the pointer as one.
//
// ⊕ `done-text` and `done` - the word the button says for a moment after it
// did its thing: "Copied" for two seconds after a copy went through (the
// owner's point 7 of 2026-10-10, `D121`). The button is as wide as the longer
// of its two words at all times, so the word changing moves nothing beside
// it - the two words are laid one on the other and the box takes the wider,
// as the layout measures them. Rust decides when it is done and for how
// long, and the button only draws it.
import { Tokens } from "../tokens.slint";
import { TextSmall } from "typography.slint";
import { Chevron } from "chrome.slint";

// Which side of the word an arrow stands on, if any.
export enum ButtonArrow { none, back, forward }

export component SmallButton inherits Rectangle {
    in property <string> text;
    // What a click does, as UI Automation reads it. Two buttons may share one
    // word - the palette has two Copy buttons - and this tells them apart.
    in property <string> action;
    in property <bool> enabled: true;
    // The window's main action - see the header.
    in property <bool> primary;
    // A triangle beside the word - see the header.
    in property <ButtonArrow> arrow: ButtonArrow.none;
    // What the button says while `done` - see the header. Empty for a
    // button with no such moment, which is then as wide as its word.
    in property <string> done-text;
    in property <bool> done;
    callback clicked();

    // The word's colour, which the arrow wears too.
    property <color> ink: root.primary ? Tokens.surface
        : root.enabled && (area.has-hover || area.pressed) ? Tokens.accent
        : Tokens.text-secondary;

    horizontal-stretch: 0;
    vertical-stretch: 0;
    min-width: content.min-width;
    preferred-width: content.preferred-width;
    height: content.preferred-height;

    border-width: Tokens.hairline;
    border-radius: Tokens.radius-small;
    border-color: !root.enabled ? Tokens.border
        : root.primary && (area.pressed || area.has-hover) ? Tokens.text-primary
        : root.primary ? Tokens.accent
        : area.pressed ? Tokens.accent
        : area.has-hover ? Tokens.border-strong
        : Tokens.border;
    background: root.primary ? (root.enabled && area.pressed ? Tokens.border-strong : Tokens.accent)
        : root.enabled && area.pressed ? Tokens.surface-sample : Tokens.surface-raised;
    opacity: root.enabled ? 1 : Tokens.alpha-disabled;

    accessible-role: button;
    accessible-label: root.done ? root.done-text : root.text;
    accessible-description: root.action;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }

    content := HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-2;
        padding-top: Tokens.space-1;
        padding-bottom: Tokens.space-1;
        spacing: Tokens.space-1;
        alignment: center;

        // Centred on the word's line: a path has no baseline, and a layout
        // would put it at the top.
        if root.arrow == ButtonArrow.back: VerticalLayout {
            alignment: center;
            Chevron {
                open: false;
                backward: true;
                ink: root.ink;
            }
        }
        // Both words, one on the other, in a box as wide and as tall as the
        // larger: the frame stays put when the word changes.
        Rectangle {
            min-width: max(word.preferred-width, done-word.preferred-width);
            preferred-width: self.min-width;
            min-height: max(word.preferred-height, done-word.preferred-height);
            preferred-height: self.min-height;
            word := TextSmall {
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                text: root.text;
                color: root.ink;
                visible: !root.done;
            }
            done-word := TextSmall {
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                text: root.done-text;
                color: root.ink;
                visible: root.done;
            }
        }
        if root.arrow == ButtonArrow.forward: VerticalLayout {
            alignment: center;
            Chevron {
                open: false;
                ink: root.ink;
            }
        }
    }
}

// A choice between ways, every way on screen and the one in effect filled.
//
// # Why not a button (the owner's point 2, 2026-10-07)
//
// The palette said how a typed value meets the field in a sentence and offered
// the OTHER way on a button - "Insert at cursor" beside "The line is cleared
// before each value". The owner could not tell which way was in effect and
// which one a click would give: a button names what it DOES, and here what it
// does is the state the tester is not in. A switch names both ways and fills
// the one in effect, so the state is read off the control itself and a click
// on the other half is the change.
//
//     the way in effect   ground in the accent, word in the window's ground
//                         colour - the pair the primary button already wears,
//                         so no new colour pair is measured into the product
//     another way         the word in the secondary colour on the raised ground
//     pointer there       the word in the accent
//     pressed there       the ground sunk to `surface-sample`
//     keyboard here       NEVER in the palette, `SmallButton`'s reason (`D62`)
//     cannot be used      faded as a whole, no pointer and no click
//
// A click on the way already in effect asks for nothing: it is not a change.
// The ways come as a list, so a third is more data and never more markup (GUI
// rule 8), and the index chosen goes back to Rust, which decides what it means.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <bool> enabled: true;
    // What the choice is about, as UI Automation reads the group - the label
    // the row gives it on screen.
    in property <string> label;
    callback chosen(int);

    horizontal-stretch: 0;
    vertical-stretch: 0;
    min-width: ways.min-width;
    preferred-width: ways.preferred-width;
    height: ways.preferred-height;

    border-width: Tokens.hairline;
    border-radius: Tokens.radius-small;
    border-color: Tokens.border;
    background: Tokens.surface-raised;
    clip: true;
    opacity: root.enabled ? 1 : Tokens.alpha-disabled;

    accessible-role: radio-group;
    accessible-label: root.label;
    accessible-enabled: root.enabled;

    ways := HorizontalLayout {
        for option[index] in root.options: segment := Rectangle {
            property <bool> on: index == root.selected;
            min-width: way.min-width;
            preferred-width: way.preferred-width;
            height: way.preferred-height;
            background: self.on ? Tokens.accent
                : root.enabled && area.pressed ? Tokens.surface-sample
                : transparent;

            accessible-role: radio-button;
            accessible-label: option;
            accessible-checkable: true;
            accessible-checked: self.on;
            accessible-enabled: root.enabled;
            accessible-action-default => {
                if root.enabled && !self.on {
                    root.chosen(index);
                }
            }

            area := TouchArea {
                enabled: root.enabled && !segment.on;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => {
                    root.chosen(index);
                }
            }

            way := HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                padding-top: Tokens.space-1;
                padding-bottom: Tokens.space-1;
                alignment: center;

                TextSmall {
                    text: option;
                    color: segment.on ? Tokens.surface
                        : root.enabled && (area.has-hover || area.pressed) ? Tokens.accent
                        : Tokens.text-secondary;
                }
            }
        }
    }
}
