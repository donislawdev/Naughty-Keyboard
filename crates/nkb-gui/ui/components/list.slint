// A list to pick one thing from: the packs, and the shortcuts (K5).
//
// # Built for the count the list WILL have, not the count it has
//
// PORADNIK-GUI 8: the catalogue ships nine packs today, twenty are specified,
// and team and personal folders add more. So the list sits under a search
// field (the screen's job) and scrolls (this file's job), and its rows come
// from DATA - a model of `PickRow` - so a longer list is more data, never more
// markup (GUI rule 8).

import { Tokens } from "../tokens.slint";
import { TextTitle, TextName, TextBody, TextSmallMuted } from "typography.slint";
import { Pill, Chevron } from "chrome.slint";


// One row, as finished strings and facts.
//
// The flags are FACTS and the view picks the look: `badge-risky` says the badge
// names a risk, and which colour a risk wears is the dictionary's business
// (document 13 section 2.1). `has-badge` exists because comparing `badge` with
// an empty string would put a quoted string in a view, which `ui_guard.rs`
// refuses (D58).
//
// Three shapes, one row: a pack is a name over what it is for (`detail-wraps`),
// a shortcut is an action on ONE line with its key combination at the end -
// the way a menu shows its shortcuts (K5) - and a value is one line too, with
// what it types at the end where a shortcut has its keys (`D110`, the owner's
// point 3). The flags are the whole difference, so a change to how a row is
// selected, pressed or faded reaches every list at once (GUI rule 5).
export struct PickRow {
    title: string,
    detail: string,
    badge: string,
    has-badge: bool,
    badge-risky: bool,
    // The thing in use right now - the pack the palette holds, the shortcut
    // being recorded.
    current: bool,
    // False for a row that cannot be chosen, such as a pack that does not load.
    // It stays in the list, faded, because a thing that vanished from a list
    // cannot be asked about - untouchable rule 1.
    enabled: bool,
    // No detail at all: the row is its title, and a key if it has one - a
    // heading, an action. A row that is neither this nor `detail-wraps` is a
    // value, one line with its detail at the end.
    single-line: bool,
    // A key combination at the end of the row, in the typeface the hint bar
    // writes keys in: `Alt+Shift+N`.
    key: string,
    has-key: bool,
    // The badge names where the tester stands - the value the next press
    // sends (UX2) - so it wears the accent, as `current` does. A fact, like
    // `badge-risky`, and the look is chosen here.
    badge-current: bool,
    // A section heading, not a thing to pick: drawn as a small muted label.
    // Never selected and never pressed, unless it also folds (below) - the
    // fold of the values used last is a heading the tester opens.
    heading: bool,
    // ⊕ The tree (the owner's points 4 to 6, 2026-10-07). A row in the tree
    // keeps the column of the fold marks at its left, mark or not, so every
    // title of one level starts in one column (GUI rule 19).
    tree: bool,
    // The row stands under another one: one step in from that row's title,
    // and no column of fold marks of its own, since it never folds.
    child: bool,
    // The row folds what stands under it - and whether that is open now.
    foldable: bool,
    open: bool,
    // The detail stands on a line of its own and wraps rather than elides:
    // what a pack is for, which the owner could not read cut off (point 6).
    // Nothing in the row changes while the list is open, so a row taller by a
    // line moves nothing under the tester's eyes.
    detail-wraps: bool,
    // The detail is a value as the palette previews it, in the typeface of
    // values (point 5): `Kowalski␣`, `255 × "a"`.
    detail-mono: bool,
    // Beside the name, in the muted role: the pack of a value listed away from
    // it, or where a query found a row in a part it does not show.
    aside: string,
    has-aside: bool,
}

// One row, in every state.
//
//     pointer here     ground one step brighter (`surface-raised`)
//     pressed          ground one step DARKER (`surface-sample`)
//     keyboard here    the edge in the accent
//     in use           a pill with the word - never the colour alone
//     cannot be used   faded as a whole, no pointer state
//     folds            a mark at the left, right when closed and down when
//                      open, in the accent under the pointer - a click on the
//                      mark folds, a click on the rest of the row chooses
//
// 🔴 Pressed goes DARKER, and that is measured rather than a style. Every
// ground brighter than `surface-raised` takes `text-muted` below 4.5:1 - the
// best candidate gave 4.11 - so a brighter pressed step would have been one
// more colour pair that fails. The inset ground is already measured with every
// text role, and a row that sinks when pressed reads as pressed.
//
// # Why the pills moved onto the title's line (2026-10-07)
//
// They stood in a column of their own at the right, beside BOTH lines, and
// took that width from the detail line too - which is where the description
// of a pack now has to be read whole. On the title's line they take width
// from the title alone, which elides.
component PickRowView inherits Rectangle {
    in property <PickRow> item;
    in property <bool> selected;
    in property <string> current-label;
    callback clicked();
    // A click on the fold mark.
    callback toggled();
    // Asks the list to scroll so that this row is visible.
    callback reveal(length, length);

    // The row is one line: a heading, an action with its key, or a value with
    // what it types at the end of the line. Only a pack is two - its name
    // over what it is for, which is read whole.
    property <bool> one-line: root.item.single-line || !root.item.detail-wraps;
    // A value, with what it types at the right edge of its line.
    property <bool> value-line: !root.item.single-line && !root.item.heading && !root.item.detail-wraps;

    border-radius: Tokens.radius;
    border-width: Tokens.hairline;
    border-color: root.selected ? Tokens.accent : transparent;
    background: !root.item.enabled ? transparent
        : area.pressed ? Tokens.surface-sample
        : area.has-hover ? Tokens.surface-raised
        : transparent;
    // A heading cannot be chosen either, but it is not faded: it is a label,
    // not an unavailable thing.
    opacity: root.item.enabled || root.item.heading ? 1 : Tokens.alpha-disabled;
    height: content.preferred-height;

    // A row that becomes the selected one brings itself into view - the arrow
    // keys move the selection, and a selection below the fold is a selection
    // the tester cannot see. Asked on creation as well, because the list opens
    // with the pack in use already selected.
    changed selected => {
        if self.selected {
            root.reveal(self.y, self.height);
        }
    }
    init => {
        if self.selected {
            root.reveal(self.y, self.height);
        }
    }

    area := TouchArea {
        enabled: root.item.enabled;
        clicked => {
            root.clicked();
        }

        content := HorizontalLayout {
            padding: Tokens.space-2;
            spacing: Tokens.space-2;

            // A row under another: ONE step in from the title of the row it
            // stands under - the fold mark's column and one spacing step past
            // it. Until 2026-10-07 a value stood two whole columns in, the
            // second one empty because a value never folds, and the owner
            // found the gap at the left of the value window "fatal" (point 3).
            if root.item.child: Rectangle {
                width: Tokens.fold-column + Tokens.space-4;
            }
            // The column of the fold marks, kept by every row of a tree's top
            // level so their titles start in one column (GUI rule 19). The
            // mark has a pointer of its own and answers before the row does,
            // so a click on it folds and a click beside it chooses - the whole
            // height of the row is the mark's target, not the few pixels of
            // the triangle.
            if root.item.tree && !root.item.child: Rectangle {
                width: Tokens.fold-column;
                if root.item.foldable: fold := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggled();
                    }
                    VerticalLayout {
                        alignment: start;
                        // On the title's line, whatever the row's height: a
                        // wrapped description must not pull the mark down.
                        padding-top: Tokens.space-1;
                        HorizontalLayout {
                            alignment: center;
                            Chevron {
                                open: root.item.open;
                                ink: fold.has-hover ? Tokens.accent : Tokens.text-secondary;
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: Tokens.space-1;
                horizontal-stretch: 1;

                title-line := HorizontalLayout {
                    spacing: Tokens.space-2;

                    // Elided, not wrapped: a row that grows a line because of
                    // a long name moves every row below it.
                    if root.item.heading: TextSmallMuted {
                        text: root.item.title;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if !root.item.heading: TextName {
                        text: root.item.title;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    // Where a row was found, or the pack of a value listed away
                    // from it - beside the name, quieter than it.
                    if root.item.has-aside: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        TextSmallMuted {
                            text: root.item.aside;
                            overflow: elide;
                        }
                    }

                    // 🔴 A one-line row is as tall as a pill whether it shows
                    // one or not. Measured on the first render: a title is
                    // shorter than a pill, so the rows with a pill stood
                    // taller, and the pill that appears when recording starts
                    // moved every row below it. This pill is never drawn and
                    // takes no width - it only lends the row its height, so the
                    // floor follows the pill's own typeface and padding instead
                    // of a number fitted to one machine (GUI rule 14). A value
                    // is one line too, and its `next` pill comes and goes.
                    if root.one-line && !root.item.heading: Pill {
                        text: root.current-label;
                        width: 0px;
                        visible: false;
                    }
                    if root.item.current: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Pill {
                            text: root.current-label;
                            tint: Tokens.accent;
                        }
                    }
                    if root.item.has-badge: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Pill {
                            text: root.item.badge;
                            tint: root.item.badge-risky ? Tokens.risk
                                : root.item.badge-current ? Tokens.accent
                                : Tokens.text-muted;
                        }
                    }
                    // Last, at the row's right edge, so the combinations of
                    // every row end in one column whatever the pills before
                    // them say.
                    if root.item.has-key: TextBody {
                        text: root.item.key;
                        font-family: Tokens.font-mono;
                        horizontal-stretch: 0;
                    }
                    // What a value types, at the right edge as a key is in the
                    // shortcuts window: the name reads on the left, the value
                    // in one column on the right, and the row is one line -
                    // the owner's point 3, where two short lines left most of
                    // the window's width empty. Elided like the name, at the
                    // end, because a value can be any length - the palette
                    // shows it whole once it is chosen.
                    if root.value-line && root.item.detail-mono: TextBody {
                        text: root.item.detail;
                        font-family: Tokens.font-mono;
                        overflow: elide;
                        horizontal-alignment: right;
                        horizontal-stretch: 1;
                        max-width: self.preferred-width;
                    }
                    if root.value-line && !root.item.detail-mono: TextBody {
                        text: root.item.detail;
                        overflow: elide;
                        horizontal-alignment: right;
                        horizontal-stretch: 1;
                        max-width: self.preferred-width;
                    }
                }

                // What a pack is for, whole: wrapped, and directly in the
                // column rather than in a layout of its own, which behind an
                // `if` would report one line for the wrapped text
                // (`slint.md` 2.23).
                if !root.one-line && !root.item.heading: TextBody {
                    text: root.item.detail;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// The list: rows from a model, one of them selected, scrolling when it has to.
//
// With no rows it says why, in `empty-text` - a list that is empty and silent
// looks the same as a list that failed (GUI rule 3).
export component PickList inherits Rectangle {
    in property <[PickRow]> rows;
    in property <int> selected;
    in property <string> current-label;
    in property <string> empty-text;
    callback clicked(int);
    // A click on the fold mark of a row.
    callback toggled(int);

    // As tall as its rows, or as its empty sentence, when nothing asks for
    // more - so the catalogue shows the whole list. A window that gives it
    // `vertical-stretch` makes it fill the room and scroll inside it.
    preferred-height: root.rows.length == 0 ? empty-note.preferred-height : stack.preferred-height;

    flick := Flickable {
        content-width: self.width;
        content-height: stack.preferred-height;

        stack := VerticalLayout {
            width: flick.width;
            alignment: start;
            spacing: Tokens.space-1;

            for row[index] in root.rows: PickRowView {
                item: row;
                selected: index == root.selected;
                current-label: root.current-label;
                clicked => {
                    root.clicked(index);
                }
                toggled => {
                    root.toggled(index);
                }
                // The smallest move that shows the whole row: up to its top
                // when it is above the view, down to its bottom when below.
                reveal(top, tall) => {
                    if top + flick.content-y < 0 {
                        flick.content-y = -top;
                    } else if top + tall + flick.content-y > flick.height {
                        flick.content-y = flick.height - top - tall;
                    }
                }
            }
        }
    }

    // The thumb: a sign that there is more below, drawn only when there is.
    if stack.preferred-height > flick.height: Rectangle {
        x: root.width - Tokens.scroll-thumb;
        y: -flick.content-y * flick.height / stack.preferred-height;
        width: Tokens.scroll-thumb;
        height: flick.height * flick.height / stack.preferred-height;
        border-radius: Tokens.scroll-thumb / 2;
        background: Tokens.border-strong;
    }

    // Always built and shown only when empty, so its height can be read above.
    empty-note := VerticalLayout {
        visible: root.rows.length == 0;
        alignment: start;
        padding: Tokens.space-2;
        TextBody {
            text: root.empty-text;
            wrap: word-wrap;
        }
    }
}

// The name of the thing in use, as the way to choose another - the pack's name
// in the palette, which opens the pack window.
//
// `title`: the name is the window's title as well - the palette's header
// (`WindowHeader { opens: true }`) - and is written in the title role, in the
// primary colour at rest, like every other window's title. A link elsewhere
// stays in the body role and the secondary colour.
//
//     pointer here     the name - and its mark, when it has one - in the accent,
//                      like a link
//     pressed          the same - the pack window opens at once, so there is no
//                      moment to show a second step in
//     keyboard here    NEVER, on purpose: the palette refuses the keyboard focus
//                      (`D62`), so the keyboard's way in is the shortcut the hint
//                      bar names - and a focus ring that can never show is a
//                      state the gallery would have to fake
//     cannot be used   not a state it has: the pack window is how a pack is
//                      chosen even when none opened
//
// A click reaches the palette without activating it (measured, `D62`), so the
// field under test keeps the keyboard until the pack window takes it itself.
// The name is elided, like the text it replaces: the counter beside it keeps
// its place.
//
// ⚠️ The first design raised the GROUND under the pointer, as a list row does.
// With no padding - which alignment demands, see below - the ground hugged the
// letters and read as a text selection, barely visible in the render. The
// colour of the letters is what changes now: visible, and the accent holds its
// contrast even in the dimmed state (`D53`).
//
// # The mark after the name (`UX-GUI-015`)
//
// With the pointer elsewhere, the name looked like every other line of the
// palette, so the way to choose another pack by mouse was there and unseen. A
// name that opens a list to choose from now carries a small downward triangle
// after its words, at rest as well - the mark a drop-down list wears, in the
// words' own colour, so it changes with them under the pointer. A shape drawn
// here rather than a character: a character would be a quoted string, which a
// view may not hold (`D58`), and its look would depend on the typeface.
//
// Only where a click opens a list. The link to the shortcuts window opens a
// window of settings, not a choice, and carries no mark.
export component PickerOpener inherits Rectangle {
    in property <string> text;
    // What a click does, as UI Automation reads it - the same words the hint
    // bar gives the shortcut, so a tester and a harness find it by one name.
    in property <string> action;
    // The click opens a list to choose from - see the header.
    in property <bool> chevron;
    // The window's title - see the header.
    in property <bool> title;
    callback clicked();

    // The words and the mark wear one colour, so the pair reads as one thing.
    property <color> ink: area.has-hover || area.pressed ? Tokens.accent
        : root.title ? Tokens.text-primary
        : Tokens.text-secondary;

    min-width: content.min-width;
    preferred-width: content.preferred-width;
    height: content.preferred-height;
    // Stated, because a fixed height does not say it (`slint.md` 2.29).
    vertical-stretch: 0;
    horizontal-stretch: 0;

    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.action;
    accessible-action-default => {
        root.clicked();
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    // No padding of its own, on purpose: the name stays in the column every
    // other band of the palette starts in (GUI rule 19). The first render with
    // `space-1` each side put it four pixels right of the value name below.
    content := HorizontalLayout {
        spacing: Tokens.space-1;
        if !root.title: TextBody {
            text: root.text;
            overflow: elide;
            color: root.ink;
        }
        if root.title: TextTitle {
            text: root.text;
            overflow: elide;
            color: root.ink;
        }
        // Centred on the line, and never squeezed: a long name gives way
        // before the mark does, as it gives way before the counter.
        if root.chevron: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Chevron {
                ink: root.ink;
            }
        }
    }
}

// A heading that folds what stands under it - the last value sent in the
// palette (the owner's point 7, 2026-10-07): closed, the band is this one row,
// and open, the whole value is drawn below it.
//
//     at rest          the mark and the heading in the muted role, the detail
//                      after them in the secondary one
//     pointer here     the mark and the heading in the accent, like a link
//     pressed          the same - the fold opens at once
//     keyboard here    NEVER, for `PickerOpener`'s reason: the palette refuses
//                      the keyboard focus (`D62`)
//     cannot be used   faded as a whole, no pointer and no click - before the
//                      first value there is nothing to unfold, and the band
//                      stands in place rather than appearing with the first
//                      press and moving everything below it (2026-10-07)
//
// The mark points right while closed and down while open (`Chevron`), and it
// stands BEFORE the words - the mark a tree wears - where `PickerOpener` puts
// its mark after them, the mark a drop-down list wears. The two say different
// things: this one shows more of the same window, that one opens another.
//
// `detail` is said only while closed: open, the band below names the value in
// full, and the name twice would be the noise the owner asked to take away.
export component Disclosure inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> open;
    in property <bool> enabled: true;
    // What a click does, as UI Automation reads it.
    in property <string> action;
    callback clicked();

    property <color> ink: root.enabled && (area.has-hover || area.pressed) ? Tokens.accent : Tokens.text-muted;

    min-width: content.min-width;
    height: content.preferred-height;
    vertical-stretch: 0;
    opacity: root.enabled ? 1 : Tokens.alpha-disabled;

    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.action;
    accessible-enabled: root.enabled;
    accessible-expanded: root.open;
    accessible-expandable: true;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }

    // No padding of its own: the heading stays in the column every other band
    // of the palette starts in (GUI rule 19), as `PickerOpener` does.
    content := HorizontalLayout {
        spacing: Tokens.space-2;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Chevron {
                open: root.open;
                ink: root.ink;
            }
        }
        TextSmallMuted {
            text: root.text;
            color: root.ink;
            horizontal-stretch: 0;
        }
        if !root.open: TextBody {
            text: root.detail;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}
