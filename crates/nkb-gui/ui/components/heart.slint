// The heart before the word Donate (the owner's point 5, 2026-10-14).
//
// A shape drawn here rather than a character, for the reason `Chevron` gives
// in `chrome.slint`: a character would be a quoted string, which a view may not
// hold (`D58`), and its look would depend on the typeface - the bundled one is
// monospaced and the system's may not carry the sign at all. In a file of its
// own, because `chrome.slint` and `list.slint` stand near the Slint ceiling of
// `D113`, and a curve takes lines.
//
// The outline is the common filled heart: two round lobes meeting in a point,
// drawn on a 20 by 18.35 box and scaled to the token's size. It takes the ink
// of the words beside it, so the pair changes colour as one under the pointer.

import { Tokens } from "../tokens.slint";

export component Heart inherits Rectangle {
    in property <color> ink: Tokens.text-secondary;

    width: Tokens.heart-width;
    height: Tokens.heart-height;

    Path {
        width: Tokens.heart-width;
        height: Tokens.heart-height;
        viewbox-x: 2;
        viewbox-y: 3;
        viewbox-width: 20;
        viewbox-height: 18.35;
        fill: root.ink;
        MoveTo {
            x: 12;
            y: 21.35;
        }
        LineTo {
            x: 10.55;
            y: 20.03;
        }
        CubicTo {
            control-1-x: 5.4;
            control-1-y: 15.36;
            control-2-x: 2;
            control-2-y: 12.28;
            x: 2;
            y: 8.5;
        }
        CubicTo {
            control-1-x: 2;
            control-1-y: 5.42;
            control-2-x: 4.42;
            control-2-y: 3;
            x: 7.5;
            y: 3;
        }
        CubicTo {
            control-1-x: 9.24;
            control-1-y: 3;
            control-2-x: 10.91;
            control-2-y: 3.81;
            x: 12;
            y: 5.09;
        }
        CubicTo {
            control-1-x: 13.09;
            control-1-y: 3.81;
            control-2-x: 14.76;
            control-2-y: 3;
            x: 16.5;
            y: 3;
        }
        CubicTo {
            control-1-x: 19.58;
            control-1-y: 3;
            control-2-x: 22;
            control-2-y: 5.42;
            x: 22;
            y: 8.5;
        }
        CubicTo {
            control-1-x: 22;
            control-1-y: 12.28;
            control-2-x: 18.6;
            control-2-y: 15.36;
            x: 13.45;
            y: 20.04;
        }
        Close { }
    }
}
