// The two bands of the palette that show a value: the one the next press
// sends, before it goes, and the one that went out last.
//
// Each is a section with its own state and its own controls, so each is a
// component from the start rather than a block inside the screen (GUI rule 9).
// They stood inside `screens/palette.slint` until 2026-10-10, when that file
// reached the ceiling of `D113` and the next changes to both bands were about
// to land: the arrows that walk the pack, and the report block under the last
// value. Moved word for word - the renders of the palette came out the same to
// the byte.
//
// Only the palette uses them, and the door still re-exports them like every
// other component: a screen sees the vocabulary through one file, and the
// gallery shows each band in its states.

import { Tokens } from "../tokens.slint";
import { TextName, TextBody, TextMono, TextPreview, TextSmallMuted } from "typography.slint";
import { Spacer, Zone, Marker, MarkerRow } from "chrome.slint";
import { SmallButton } from "button.slint";
import { Disclosure } from "list.slint";

// What the next press sends (UX-GUI-001). One line each, ELIDED rather than
// wrapped, and every line kept at the end of a pack, where there is no value -
// drawn empty rather than taken away: the band changes with every press, and a
// band that grew and shrank would move everything below it. The whole value is
// drawn in the band below once it is sent. Expanded only - the heading is muted
// (D53).
//
// While a send runs, which value comes next depends on how the one in flight
// ends, so the band fades in place rather than going away and taking its height
// with it.
export component NextBand inherits Zone {
    // Every string is finished text from `i18n`. Which value it is comes from
    // the core's `Sequence::upcoming`, which a test holds to what the press
    // really does.
    in property <string> heading;
    // False at the end of a pack, where the next press only says so and the
    // band is its heading alone.
    in property <bool> has-value;
    in property <string> name;
    in property <string> preview;
    in property <[Marker]> markers;
    // The Copy button's word and what it does in UI Automation's words.
    in property <string> copy-label;
    in property <string> copy-action;
    in property <bool> sending;
    callback copy();

    divided: false;
    opacity: root.sending ? Tokens.alpha-disabled : 1;

    // Copy at the other end of the heading's row, where the band below has its
    // own: the two buttons stand in one column, each at the top of the value it
    // copies (D98). Not at the end of a pack - there is no value to copy then -
    // and its place kept.
    HorizontalLayout {
        spacing: Tokens.space-2;
        // Centred on the button's row: the heading's height is its own text,
        // and a layout puts such an element at the top - four pixels above the
        // word beside it, in the first render.
        VerticalLayout {
            alignment: center;
            TextSmallMuted {
                text: root.heading;
                overflow: elide;
            }
        }
        Spacer { }
        SmallButton {
            text: root.copy-label;
            action: root.copy-action;
            visible: root.has-value;
            enabled: root.has-value && !root.sending;
            clicked => {
                root.copy();
            }
        }
    }
    // The risk beside the name rather than on a row of its own: the palette
    // stays on top of the application under test, and a row spent on one pill
    // is height taken from it. The name gives way, the pill does not, and the
    // line is a pill's height when there is none, so a value with a risk is as
    // tall as one without.
    HorizontalLayout {
        spacing: Tokens.space-2;
        TextName {
            text: root.name;
            overflow: elide;
            horizontal-stretch: 1;
            visible: root.has-value;
        }
        // Empty at the end of a pack, where a layout has no `visible` of its
        // own to hide it by - and as tall as a pill either way.
        MarkerRow {
            markers: root.has-value ? root.markers : [];
            keeps-height: true;
        }
    }
    TextPreview {
        text: root.preview;
        overflow: elide;
        visible: root.has-value;
    }
}

// The value that went out last. It stays until the next one.
//
// FOLDED at every start (the owner's point 7, 2026-10-07): the heading and the
// value's name on one row, and the rest under a click. Every line below stands
// behind its own `if` rather than inside one folding layout: a layout behind an
// `if` reports one line for each of its texts that wraps (`slint.md` 2.23), and
// the preview, the shape and the counters all wrap. Folding hides no warning:
// every "did less than asked" has a sentence of its own in the status line
// (untouchable rule 1), and the markers here repeat the value's facts.
//
// Before the first value the row stands faded, so the first press fills it
// rather than putting a band in and moving everything below.
export component LastSentBand inherits Zone {
    // Its heading, now that a second value stands above it.
    in property <string> label;
    // Whether the whole value is drawn under the heading, or the heading and
    // the value's name alone. Rust holds the switch - the band only draws it.
    in property <bool> open;
    // What a click on the heading does, for UI Automation.
    in property <string> action;
    callback toggle();
    // Whether a value has gone out yet.
    in property <bool> has-value;
    in property <string> name;
    // Where the value was typed, read at the press (UX8, `D104`): the program
    // and the kind of control. Never for a value put on the clipboard.
    in property <string> sent-to;
    in property <bool> has-sent-to;
    in property <string> reference;
    in property <string> counts;
    // The value as a person can see it: invisible characters stand in as
    // `nkb_core::preview::MARKER`. `ux-spec.md` 2 calls this the line without
    // which the whole unicode category is unreportable.
    in property <string> preview;
    // Said only when the preview is a fragment. Never implied: a fragment
    // presented as the whole is the silence rule 1 forbids.
    in property <string> elided;
    in property <bool> has-elided;
    // Said only when the preview draws a character the shipped typeface does
    // not guarantee (`D52`, `D66`).
    in property <string> not-guaranteed;
    in property <bool> has-not-guaranteed;
    // What the value is made of, already joined into one line by `i18n`.
    in property <string> shape;
    in property <bool> has-shape;
    in property <[Marker]> markers;
    in property <string> copy-label;
    in property <string> copy-action;
    in property <bool> sending;
    callback copy();

    // While a value goes, this band shows THAT value, not the last one sent,
    // and the button's key still names the last one. So it cannot be used then
    // - faded in place rather than taken away, because a control that vanishes
    // under the pointer moves the row it stood in (GUI rule 3).
    HorizontalLayout {
        spacing: Tokens.space-2;
        // Centred on the button's row, like the next band's heading.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Disclosure {
                text: root.label;
                detail: root.name;
                open: root.open && root.has-value;
                enabled: root.has-value;
                action: root.action;
                clicked => {
                    root.toggle();
                }
            }
        }
        SmallButton {
            text: root.copy-label;
            action: root.copy-action;
            enabled: root.has-value && !root.sending;
            clicked => {
                root.copy();
            }
        }
    }
    if root.open && root.has-value: TextName {
        text: root.name;
        wrap: word-wrap;
    }
    // Under the name, because "which value went where" is the question this
    // band answers - and a tester who switched windows a moment before the
    // press sees it here, not in a ticket a day later (`UX-GUI-013`).
    if root.open && root.has-value && root.has-sent-to: TextBody {
        text: root.sent-to;
        wrap: word-wrap;
    }
    // The preview, in the order the sketch draws: name, preview, shape,
    // counters.
    //
    // ⚠️ ONE text element rather than coloured segments, and the reason is the
    // layout engine: colouring the markers apart from the value would mean one
    // element per segment, and a horizontal layout in Slint does not wrap - a
    // hundred-code-point value at preview size would run off the window.
    // `TextPreviewInvisible` therefore stays unused for now. The marker is told
    // apart by its SHAPE, which is a visible box, rather than by colour.
    if root.open && root.has-value: TextPreview {
        text: root.preview;
        wrap: char-wrap;
    }
    if root.open && root.has-value && root.has-elided: TextSmallMuted {
        text: root.elided;
    }
    // Under the preview because it qualifies the preview, and in the muted role
    // because it is a note about the tool's display rather than a fact about
    // the value. Wrapped: a list of code points is somebody else's data and has
    // no fixed length.
    if root.open && root.has-value && root.has-not-guaranteed: TextSmallMuted {
        text: root.not-guaranteed;
        wrap: word-wrap;
    }
    if root.open && root.has-value && root.has-shape: TextBody {
        text: root.shape;
        wrap: word-wrap;
    }
    // Both wrap, and both did not until 2026-09-23: a render with the shipped
    // `len-100000` cut the counters off at the window's edge, mid-word. A
    // reference is up to 89 characters with no space in it (`pack-format.md`
    // 7), so it breaks anywhere. The counters have spaces, so they break between
    // words.
    if root.open && root.has-value: TextMono {
        text: root.reference;
        wrap: char-wrap;
    }
    if root.open && root.has-value: TextMono {
        text: root.counts;
        wrap: word-wrap;
    }
    if root.open && root.has-value: MarkerRow {
        markers: root.markers;
    }
}
