// Controls that take the keyboard: the query line, and the keys a picker
// answers before the line sees them.
//
// Separate from `chrome.slint` because these RECEIVE - they have a focus, a
// pointer state and callbacks - while everything there only arranges. Document
// 13 and PORADNIK-GUI 11 point 5: what draws and what reacts live apart, so a
// control cannot grow unnoticed inside the file of things that are only shapes.

import { Tokens } from "../tokens.slint";

// A line that takes letters without being a text field.
//
// # Why not a text field (`OBS-145`)
//
// The toolkit's text input copies and pastes on its own - `Ctrl+C` and
// `Ctrl+X` write the clipboard, `Ctrl+V` reads it - and untouchable rule 17
// promises the clipboard in two places. So this line holds no text input at
// all: a focus scope hands each key press to Rust, Rust keeps the query
// (`nkb_gui::query`) and sends it back, and the line draws it as plain text.
// There is nothing here to copy from or paste into, and that is a property of
// the structure, not of a list of keys somebody remembered to swallow.
// `clipboard_has_named_doors.rs` still refuses every text field.
//
// What that costs: no caret to move, no selection, no input-method composition.
// A search needs none of them. The mark after the text shows where the next
// letter goes and that the keyboard is here - it does not move and it does not
// blink, because nothing in this tool changes on a timer (`D83`).
//
// ⊕ The welcome window's box for the first try (UX7, `nkb_gui::trial`) is the
// same line with a caret Rust moves: `query-after` is the text after the caret,
// drawn after the mark, and empty for the search, which always types at the end.
// `shift` reaches Rust because the palette's clearing recipe holds it over `End`.
//
// # One language of states (PORADNIK-GUI 10.9)
//
//     pointer here      the edge one step brighter (`border-strong`)
//     keyboard here     the edge in the accent, and the mark after the text -
//                       a different axis from the pointer, so both at once are
//                       still told apart
//     cannot be used    no edge, the text faded - no invitation
//     value is wrong    the edge in `risk`, and a sentence under the line
//                       carries the meaning, and the colour is the third carrier
//
// The TEXT colour never changes with the pointer - the owner's rule at the end
// of PORADNIK-GUI.
//
// # A query longer than the line
//
// The line shows the END, where the next letter lands, and clips the start at
// the inner padding. The text measures its own width and the line scrolls it -
// in a layout, a text that does not wrap may not be narrower than itself, and
// a long query would have widened the whole window (`slint.md` 2.29).
export component QueryField inherits Rectangle {
    in property <string> query;
    // The text after the caret - see the header. Empty: the caret is at the end.
    in property <string> query-after;
    in property <bool> enabled: true;
    in property <bool> invalid;
    // What UI Automation calls the line - the address a harness finds it by
    // (`slint.md` 2.11). A key from `i18n`, like every word a person meets.
    in property <string> accessible-name;
    out property <bool> has-focus: scope.has-focus;
    // One key press, as the text it produced and the modifiers held. Rust
    // answers whether the press was the query's: false lets it travel on, so a
    // key the query does not want is not silently eaten.
    callback pressed(text: string, control: bool, alt: bool, shift: bool, meta: bool) -> bool;
    // The window holding the line stopped being the active one - the tester
    // clicked another window or switched away. Only that reason: focus moved
    // by code or by a click inside the window is not the tester leaving
    // (`OBS-147`). Rust cannot name the reason itself, the type is not public.
    callback window-left();
    // The window holding the line became the active one - the system handed
    // it the keyboard. Only that reason, like `window-left`: Rust forgets the
    // modifiers the toolkit still believes held (`OBS-151`).
    callback window-entered();

    // Moves the keyboard to the line. A function rather than a property,
    // because focusing is an act, not a state the view could hold.
    public function focus-field() {
        scope.focus();
    }

    background: root.enabled ? Tokens.surface-sample : Tokens.surface;
    clip: true;
    border-radius: Tokens.radius;
    border-width: Tokens.hairline;
    border-color: !root.enabled ? transparent
        : root.invalid ? Tokens.risk
        : scope.has-focus ? Tokens.accent
        : area.has-hover ? Tokens.border-strong
        : Tokens.border;
    // As tall as its text and padding, and never taller: stretched in a column
    // it would become an empty bordered box, which reads as a failure rather
    // than as room (PORADNIK-GUI 6).
    height: row.preferred-height;
    // 🔴 Stated, because a fixed height does not say it. The line inside
    // stretches sideways, the stretch travels up through the layout, and the
    // first render of the pack window gave the column holding this line half
    // of the spare height - the search label floated in the middle of it
    // (`slint.md` 2.29).
    vertical-stretch: 0;

    scope := FocusScope {
        enabled: root.enabled;
        accessible-role: text-input;
        accessible-label: root.accessible-name;
        accessible-value: root.query + root.query-after;
        key-pressed(event) => {
            return root.pressed(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) ? accept : reject;
        }
        focus-lost(reason) => {
            if (reason == FocusReason.window-activation) {
                root.window-left();
            }
        }
        focus-gained(reason) => {
            if (reason == FocusReason.window-activation) {
                root.window-entered();
            }
        }

        area := TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.text;
            clicked => {
                scope.focus();
            }

            row := HorizontalLayout {
                padding-left: Tokens.space-3;
                padding-right: Tokens.space-3;
                padding-top: Tokens.space-2;
                padding-bottom: Tokens.space-2;

                // Clipped here, at the padding, rather than only at the border:
                // a scrolled query must not run under the edge.
                Rectangle {
                    clip: true;
                    horizontal-stretch: 1;
                    // Stated, not left to the text inside: see the header.
                    min-width: 0px;
                    preferred-width: 0px;
                    min-height: shown.preferred-height;
                    preferred-height: shown.preferred-height;

                    shown := Text {
                        text: root.query;
                        color: root.enabled ? Tokens.text-primary : Tokens.text-muted;
                        font-size: Tokens.type-body;
                        vertical-alignment: center;
                        width: self.preferred-width;
                        height: parent.height;
                        // At the left while it fits, scrolled so the end and
                        // the mark stay in view once it does not.
                        x: min(0px, parent.width - self.width - Tokens.caret-width);
                    }

                    Rectangle {
                        visible: scope.has-focus;
                        x: shown.x + shown.width;
                        width: Tokens.caret-width;
                        height: parent.height;
                        background: Tokens.accent;
                    }

                    // After the mark, and clipped at the right edge when it
                    // does not fit: the caret stays in view, the end may not.
                    Text {
                        text: root.query-after;
                        color: root.enabled ? Tokens.text-primary : Tokens.text-muted;
                        font-size: Tokens.type-body;
                        vertical-alignment: center;
                        width: self.preferred-width;
                        height: parent.height;
                        x: shown.x + shown.width + Tokens.caret-width;
                    }
                }
            }
        }
    }
}

// The keyboard of a whole window, handed to Rust one press and one release at
// a time.
//
// For a window where every key means something - the shortcuts window, where
// a combination is recorded by pressing it (K5). Unlike `PickerKeys` it takes
// the keyboard, and unlike `QueryField` it draws nothing: the window's content
// sits inside it, and what a key does is Rust's decision (GUI rule 11).
//
// 🔴 The text and the modifiers passed on are what the TOOLKIT believes, and
// for a key combination that is not enough: the text of a key depends on the
// layout (`Shift+1` arrives as `!`), and a left `Ctrl` with a left `Alt` over a
// key the layout types a character on arrives as that character with neither
// modifier (`slint.md` 2.29). Which key was pressed is therefore asked of the
// system by Rust, and a press here is only the moment to ask.
//
// Releases are passed on because a combination is built while keys are held:
// letting go of `Shift` before the key changes what is being recorded.
export component KeyScope inherits FocusScope {
    // Rust answers whether the press was the window's: false lets it travel
    // on, so a key the window does not want is not silently eaten.
    callback pressed(text: string, control: bool, alt: bool, shift: bool, meta: bool) -> bool;
    callback released(text: string) -> bool;
    // The window stopped being the active one - see `QueryField`.
    callback window-left();
    // The window became the active one - see `QueryField` (`OBS-151`).
    callback window-entered();

    focus-on-tab-navigation: false;

    key-pressed(event) => {
        return root.pressed(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) ? accept : reject;
    }
    key-released(event) => {
        return root.released(event.text) ? accept : reject;
    }
    focus-lost(reason) => {
        if (reason == FocusReason.window-activation) {
            root.window-left();
        }
    }
    focus-gained(reason) => {
        if (reason == FocusReason.window-activation) {
            root.window-entered();
        }
    }
}

// The keys a list picker answers: move, choose, close.
//
// Caught on the way DOWN, before the focused query line sees them -
// `FocusScope`'s `capture-key-pressed`, read in the 1.18.1 source. The line
// gets every other key, so typing still types, while Up and Down move through
// the list and Enter chooses.
//
// It never takes the focus itself: a click on the list must leave the keyboard
// on the query line, where the tester's next letter belongs.
export component PickerKeys inherits FocusScope {
    callback previous();
    callback next();
    callback choose();
    callback cancel();
    // Left and right fold and open (the owner's point 4). The query line has
    // no caret to move (`OBS-145`), so the arrows are free to take.
    callback fold();
    callback unfold();

    focus-on-click: false;
    focus-on-tab-navigation: false;

    capture-key-pressed(event) => {
        if event.text == Key.UpArrow {
            root.previous();
            return accept;
        }
        if event.text == Key.DownArrow {
            root.next();
            return accept;
        }
        if event.text == Key.Return {
            root.choose();
            return accept;
        }
        if event.text == Key.Escape {
            root.cancel();
            return accept;
        }
        if event.text == Key.LeftArrow {
            root.fold();
            return accept;
        }
        if event.text == Key.RightArrow {
            root.unfold();
            return accept;
        }
        return reject;
    }
}
