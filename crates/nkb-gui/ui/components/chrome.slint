// The structural vocabulary: the pieces a screen arranges but never draws.
//
// Every one of these exists because a screen would otherwise reach for a raw
// `Rectangle`, and `ui_guard.rs` refuses that. The refusal is only fair if the
// replacement is here, so this file is the other half of the guard.

import { Tokens } from "../tokens.slint";
import { TextSmallMuted } from "typography.slint";

// A one-pixel divider between zones.
export component Hairline inherits Rectangle {
    height: Tokens.hairline;
    background: Tokens.border;
}

// Pushes its neighbours apart inside a layout. Without this a screen would use
// a bare `Rectangle { horizontal-stretch: 1; }`, which is the exact habit the
// guard is there to break.
export component Spacer inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 1;
}

// A small bordered label: the field kind, a state marker.
//
// Document 13 section 9: meaning never rests on colour alone. A pill always
// carries text, so the shape and the word are both present before the colour
// is.
export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tint: Tokens.text-muted;

    border-width: Tokens.hairline;
    border-color: root.tint;
    border-radius: Tokens.radius-small;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    // ⚠️ The size comes from an inner layout, not from arithmetic on the
    // label's preferred size. The arithmetic version shipped first and the
    // off-screen render caught it immediately: the border cut straight through
    // the word "offensive", because a hand-computed width and a centred label
    // disagree about what the text actually measures. Let the layout decide.
    // ⚠️ The horizontal padding is one step wider than looks necessary on the
    // machine this was designed on, and that is the point. Rendered on macOS
    // and on Linux the same pill is wider, because the fallback typeface has
    // different metrics - at the narrow step the border ran through the word.
    // Measured 2026-09-07 on all three systems, not guessed from one.
    HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-2;
        padding-top: Tokens.space-1;
        padding-bottom: Tokens.space-1;
        alignment: center;

        TextSmallMuted {
            text: root.text;
            color: root.tint;
        }
    }
}

// The liveness marker beside the target.
//
// ⚠️ On its own this dot breaks section 9, because a disc is a disc whatever
// its colour. It is only ever placed next to the label it qualifies, and the
// gallery shows it that way so the pairing cannot quietly come apart.
export component StatusDot inherits Rectangle {
    in property <color> tint: Tokens.ok;
    width: Tokens.space-2;
    height: Tokens.space-2;
    border-radius: self.width / 2;
    background: root.tint;
}

// The inset ground the value is previewed on.
//
// Darker than the window on purpose: a value made entirely of invisible
// characters still has to read as an object with edges, otherwise an empty
// preview and a broken preview look the same.
export component SampleSurface inherits Rectangle {
    background: Tokens.surface-sample;
    border-width: Tokens.hairline;
    border-color: Tokens.border;
    border-radius: Tokens.radius;
}

// What one hint says. A struct rather than two parallel lists, so a key and its
// action cannot drift apart by one index.
export struct HintRow {
    key: string,
    action: string,
}

// The hint bar: one hint per line, keys in their own column.
//
// 🔴 It is a GRID and it runs DOWNWARDS, and both were measured rather than
// preferred. Written as a row of hints side by side - which is how the sketch in
// `ux-spec.md` 2 draws it - three hints in the author's own language already ran
// off the right edge of a 420 px palette, and the fourth word of a German or
// Polish translation would not have fitted either. GUI rule 14: a layout is
// computed, never fitted to what the author happened to measure on their own
// machine.
//
// The grid also buys the alignment GUI rule 13 asks for: every key starts at the
// same x, so the eye reads a column instead of hunting.
export component HintBar inherits GridLayout {
    in property <[HintRow]> rows;
    spacing: Tokens.space-1;

    // The key in the secondary colour and the action muted: one size since the
    // scale lost its 11 px step (2026-10-07), so the column the eye hunts in
    // is set apart by its typeface and its colour.
    for hint in root.rows: Row {
        TextSmallMuted {
            text: hint.key;
            color: Tokens.text-secondary;
            font-family: Tokens.font-mono;
            horizontal-stretch: 0;
        }
        TextSmallMuted {
            text: hint.action;
            horizontal-stretch: 1;
        }
    }
}

// One section of a window's content, with the rule above it - a band of the
// palette, a step of the welcome.
//
// Document 13 sections 18 and 19 ask that a section be a component with its own
// spacing rather than whatever container happened to be there, and there is a
// second reason here: a band that hides must take its own divider with it.
// Written as a bare `Hairline` between bands, hiding a band leaves a rule
// floating over nothing, and the two would have to be gated in step forever.
//
// The side padding is the window's gutter, the same in every window and in its
// header and footer (`ChromeBand`), so every line of every window starts in one
// column - until 2026-10-07 the palette's was 12 px and the other windows' 16.
//
// # Why the height is stated here rather than left to the layout
//
// Measured 2026-09-23, Slint 1.18.1 (`slint.md` 2.23): a band that was itself a
// `VerticalLayout`, placed behind an `if`, reported the height of ONE line for
// every text of its own that wrapped. It laid its children out correctly - the
// line after a wrapped text sat where it should - but the palette sizes itself
// from that report, stopped short, and the rest spilled below its surface. On
// the live window, whose height is that report, it would simply be cut off.
//
// Stating the height inside the component, from the band's own layout, is what
// holds: measured with the band behind the same `if`, and with long counters,
// the longest reference and the two-line typeface note. `palette_appearance.rs`
// fails when anything is drawn below the palette's surface.
//
// ⊕ Since the palette stands in `WindowFrame` (2026-10-07, `D110`) the trap does
// not show there: without this line every render of the palette and the welcome
// came out the same to the byte - the bands reach the frame's layout through
// `@children`, and that path reports a wrapped text's height correctly. The line
// stays for a `Zone` placed straight in a layout behind an `if`, which is where
// the trap was measured, and it costs nothing where it is not needed.
export component Zone inherits Rectangle {
    in property <bool> divided: true;

    height: band.preferred-height;

    band := VerticalLayout {
        if root.divided: Hairline { }

        VerticalLayout {
            padding-left: Tokens.space-4;
            padding-right: Tokens.space-4;
            padding-top: Tokens.space-3;
            padding-bottom: Tokens.space-3;
            spacing: Tokens.space-2;
            @children
        }
    }
}

// A section that takes the room the window has left: the list of a window the
// tester resizes. `Zone`'s gutter and rule, and no height of its own - it
// stretches, so the list inside can, and scrolls inside it.
//
// Not behind an `if` anywhere, so the measured trap that gave `Zone` its stated
// height (`slint.md` 2.23) has nothing to bite here.
export component ZoneFill inherits Rectangle {
    in property <bool> divided: true;
    vertical-stretch: 1;

    VerticalLayout {
        if root.divided: Hairline { }

        VerticalLayout {
            padding-left: Tokens.space-4;
            padding-right: Tokens.space-4;
            padding-top: Tokens.space-3;
            padding-bottom: Tokens.space-3;
            spacing: Tokens.space-3;
            vertical-stretch: 1;
            @children
        }
    }
}

// A band of a window's chrome: the header above the content, the footer and
// the status line below it. Not in the door: a screen reaches chrome only
// through the frame's own pieces (`frame.slint`), so no window can build a
// header of its own (the owner's point 4).
//
// PORADNIK-GUI 4: chrome touches the window's edge, stands on a ground of its
// own and is parted from the content by a hairline - no rounding and no frame,
// because chrome is not content. The hairline sits on the side that faces the
// content, which is why the band is told where it is rather than left to guess.
//
// `dimmed`: the palette's resting state, where the window's whole ground takes
// the resting alpha (D53) - its chrome included, or the header would stand
// solid on a translucent window. `tools/kontrast.py` measures the roles the
// resting state shows on this ground too.
//
// The height is stated from the band's own layout for the reason `Zone` gives
// (`slint.md` 2.23): a band that only reports it can come out short.
export component ChromeBand inherits Rectangle {
    in property <bool> at-bottom;
    in property <bool> dimmed;
    // False where the band meets another band of chrome that already draws the
    // rule - the resting palette's status line right under its header, where
    // two rules side by side read as one thick line.
    in property <bool> divided: true;

    background: root.dimmed ? Tokens.surface-raised.with-alpha(Tokens.alpha-resting) : Tokens.surface-raised;
    height: band.preferred-height;

    band := VerticalLayout {
        if root.at-bottom && root.divided: Hairline { }

        VerticalLayout {
            padding-left: Tokens.space-4;
            padding-right: Tokens.space-4;
            padding-top: Tokens.space-3;
            padding-bottom: Tokens.space-3;
            spacing: Tokens.space-2;
            @children
        }

        if !root.at-bottom && root.divided: Hairline { }
    }
}

// How far a send got: the share of the value the application has taken (W3,
// `D96`, `OBS-160`).
//
// A measure, not a control - it takes no pointer and no keyboard. The share is
// computed and clamped in Rust and arrives as a number from 0 to 1, so the view
// only draws it: the filled part is that share of the track's width. The track
// wears the edge colour and the fill the accent, and the bar never stands alone -
// the band it sits in says in words and digits what it measures (document 13
// section 9).
//
// The fill stands in a layout packed to the start rather than at an `x` of its
// own: an element with a width and no position is centred in Slint, and a bar
// that grew from the middle would read as something else.
export component ProgressBar inherits Rectangle {
    in property <float> fraction;

    height: Tokens.progress-height;
    background: Tokens.border;
    border-radius: Tokens.radius-small;

    HorizontalLayout {
        alignment: start;
        Rectangle {
            width: root.width * root.fraction;
            background: Tokens.accent;
            border-radius: Tokens.radius-small;
        }
    }
}

// The small triangle that says a thing opens: pointing down where a click
// opens a list or a fold is open, pointing right where a fold is closed.
//
// One shape for every such mark in the product - the pack's name in the
// palette, the folds of the value window and of the last value sent - so a
// change to how the mark looks is a change in one place (GUI rule 5). Drawn as
// a path rather than a character: a character would be a quoted string, which
// a view may not hold (`D58`), and its look would depend on the typeface.
//
// Only a shape: what a click does is the business of whatever holds it, and
// the colour comes from there too, so the mark and its words wear one colour.
//
// ⊕ It also points LEFT, for the arrow on the button that steps the next value
// back (`D120`): one shape for every such triangle, so the arrows of a button
// and the marks of a fold cannot drift apart.
export component Chevron inherits Rectangle {
    // Down when true, right when false.
    in property <bool> open: true;
    // Left instead of right, where `open` is false.
    in property <bool> backward;
    in property <color> ink: Tokens.text-secondary;

    width: root.open ? Tokens.chevron-width : Tokens.chevron-height;
    height: root.open ? Tokens.chevron-height : Tokens.chevron-width;

    if root.open: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 2;
        viewbox-height: 1;
        fill: root.ink;
        MoveTo {
            x: 0;
            y: 0;
        }
        LineTo {
            x: 2;
            y: 0;
        }
        LineTo {
            x: 1;
            y: 1;
        }
        Close { }
    }
    if !root.open && root.backward: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 1;
        viewbox-height: 2;
        fill: root.ink;
        MoveTo {
            x: 1;
            y: 0;
        }
        LineTo {
            x: 0;
            y: 1;
        }
        LineTo {
            x: 1;
            y: 2;
        }
        Close { }
    }
    if !root.open && !root.backward: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 1;
        viewbox-height: 2;
        fill: root.ink;
        MoveTo {
            x: 0;
            y: 0;
        }
        LineTo {
            x: 1;
            y: 1;
        }
        LineTo {
            x: 0;
            y: 2;
        }
        Close { }
    }
}

// One thing worth knowing about the value that just went out.
//
// 🔴 `risky` is a fact, not a colour. The layer that fills this model must not
// be able to pick the tint, or appearance would start living in Rust - document
// 13 section 2.1. What is risky and what is merely worth saying is a question
// about the value. Which colour that becomes is a question about the palette.
export struct Marker {
    text: string,
    risky: bool,
}

export component MarkerRow inherits HorizontalLayout {
    in property <[Marker]> markers;
    // As tall as a pill when it holds none: for a line that must be as tall
    // with a marker as without - the next value's, which changes with every
    // press and must not move what stands below it (`D110`). Off by default,
    // so a row of markers on a line of its own takes no room when empty.
    in property <bool> keeps-height;
    spacing: Tokens.space-2;
    alignment: start;

    for marker in root.markers: Pill {
        text: marker.text;
        tint: marker.risky ? Tokens.risk : Tokens.text-muted;
    }
    // Never drawn and no width: it lends the row a pill's height from the
    // pill's own typeface and padding, not from a number fitted to one machine
    // (GUI rule 14) - the shape `PickRowView` measured first (`slint.md` 2.36).
    if root.keeps-height: Pill {
        width: 0px;
        visible: false;
    }
}
