// THE DOOR.
//
// A screen sees the vocabulary through this file and through nothing else, and
// `ui_guard.rs` enforces both halves of that: a screen may import only from
// here, and every file in `ui/components/` must be listed here.
//
// # Why a door rather than a convention
//
// The failure this prevents is specific and it is the normal case, not the
// exception: a session begins with no memory of this project, so it does not
// know that a pill, a hairline or a spacer already exists. Told to add a screen,
// it writes its own - and the second pill is never quite the first one.
//
// Searching does not fix that, because the session has to know what to search
// for. A single door does fix it: the question "what already exists" has ONE
// file as its answer, and the routing table in CLAUDE.md points at it.
//
// # A new window
//
// Starts from `WindowFrame` and `WindowHeader` in `components/frame.slint`, and
// `ui_guard.rs` refuses one that does not - the owner's point 4 of 2026-10-07,
// four windows that looked like four programs. `ChromeBand` is deliberately NOT
// re-exported below: a screen reaches chrome only through the frame's pieces,
// so it cannot build a header of its own.
//
// # Adding to the vocabulary
//
// New file in `ui/components/`, one line here, one entry in the gallery screen.
// The guard fails if the second step is skipped and the gallery is where the
// third is noticed. Say in the commit message why the existing components did
// not fit - document 13, section 8.

import { Tokens } from "tokens.slint";
import {
    TextTitle,
    TextName,
    TextBody,
    TextSmall,
    TextSmallMuted,
    TextMono,
    TextCounter,
    TextPreview,
    TextPreviewInvisible,
} from "components/typography.slint";
import {
    Hairline,
    Spacer,
    Pill,
    StatusDot,
    SampleSurface,
    HintRow,
    HintBar,
    Marker,
    MarkerRow,
    Zone,
    ZoneFill,
    ProgressBar,
    Chevron,
} from "components/chrome.slint";
import { WindowFrame, WindowHeader, WindowFooter, WindowStatus } from "components/frame.slint";
import { QueryField, PickerKeys, KeyScope } from "components/field.slint";
import { PickRow, PickList, PickerOpener, Disclosure } from "components/list.slint";
import { SmallButton, Segmented, ButtonArrow } from "components/button.slint";
import { NextBand, LastSentBand } from "components/value_bands.slint";

export {
    Tokens,
    TextTitle,
    TextName,
    TextBody,
    TextSmall,
    TextSmallMuted,
    TextMono,
    TextCounter,
    TextPreview,
    TextPreviewInvisible,
    Hairline,
    Spacer,
    Pill,
    StatusDot,
    SampleSurface,
    HintRow,
    HintBar,
    Marker,
    MarkerRow,
    Zone,
    ZoneFill,
    WindowFrame,
    WindowHeader,
    WindowFooter,
    WindowStatus,
    ProgressBar,
    QueryField,
    PickerKeys,
    KeyScope,
    PickRow,
    PickList,
    PickerOpener,
    Disclosure,
    SmallButton,
    ButtonArrow,
    Segmented,
    Chevron,
    NextBand,
    LastSentBand,
}
