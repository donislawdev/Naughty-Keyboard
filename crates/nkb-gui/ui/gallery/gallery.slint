// Every component, in every state, on one screen.
//
// Document 13 section 3 asks for this so that drift becomes visible in a single
// look instead of being discovered after five screens. It has a second job the
// document does not name: it is THE CATALOGUE. A session that wants to know
// what already exists opens `ui/components.slint` for the list and renders this
// for the picture, and it takes half a minute rather than a search that has to
// guess the right word.
//
// So: a component missing from here is a component the next session will write
// again. Adding one is three steps - the file, the line in the door, the entry
// here - and the guard only catches the second.

import {
    Tokens,
    TextName,
    TextBody,
    TextSmall,
    TextSmallMuted,
    TextHint,
    TextMono,
    TextCounter,
    TextPreview,
    TextPreviewInvisible,
    Hairline,
    Spacer,
    Pill,
    StatusDot,
    SampleSurface,
    HintRow,
    HintBar,
    Marker,
    MarkerRow,
    Zone,
    WindowSurface,
    ChromeBand,
    QueryField,
    PickList,
    PickerOpener,
} from "../components.slint";

export component Gallery inherits Window {
    title: "Naughty Keyboard - gallery";
    background: Tokens.surface;
    width: Tokens.palette-width;

    VerticalLayout {
        padding: Tokens.space-3;
        spacing: Tokens.space-2;

        TextName { text: "TextName - the value's own name"; }
        TextBody { text: "TextBody - pack name, the shape line"; }
        TextSmall { text: "TextSmall - target application"; }
        TextSmallMuted { text: "TextSmallMuted - window title, context"; }
        TextHint { text: "TextHint - the hint bar, smallest role there is"; }
        TextMono { text: "TextMono - 7 graphemes . 7 code points . 13 bytes"; }
        TextCounter { text: "TextCounter - 7 / 34"; }

        Hairline {}

        // The preview surface, holding the case it exists for: a value whose
        // content is invisible. If this reads as an empty box, the substitution
        // markers have stopped working.
        SampleSurface {
            height: Tokens.sample-height;
            HorizontalLayout {
                padding: Tokens.space-2;
                spacing: Tokens.space-1;
                alignment: start;
                TextPreview { text: "ab"; }
                TextPreviewInvisible { text: "___"; }
                TextPreview { text: "cd"; }
            }
        }

        Hairline {}

        // Pills in all three tints. The tint never carries the meaning by
        // itself - the word inside each one says the same thing.
        HorizontalLayout {
            spacing: Tokens.space-2;
            alignment: start;
            Pill { text: "text field"; }
            Pill { text: "offensive"; tint: Tokens.risk; }
            Pill { text: "clipboard mode"; tint: Tokens.accent; }
        }

        // The dot is always shown with the label it qualifies, because on its
        // own a disc is a disc whatever its colour.
        HorizontalLayout {
            spacing: Tokens.space-2;
            alignment: start;
            StatusDot {}
            TextSmall { text: "target alive"; }
            StatusDot { tint: Tokens.text-muted; }
            TextSmallMuted { text: "no target"; }
            StatusDot { tint: Tokens.risk; }
            TextSmall { text: "degraded"; }
        }

        Hairline {}

        // The markers of the value band, both tints. The tint never carries the
        // meaning by itself - the word inside each one says the same thing.
        MarkerRow {
            markers: [
                { text: "offensive", risky: true },
                { text: "cleared first", risky: false },
            ];
        }

        // The hint bar. It runs DOWNWARDS and aligns its keys in a column, and
        // the longest action below is why: side by side, three hints already ran
        // off a 420 px palette in the author's own language.
        HintBar {
            rows: [
                { key: "Alt+Shift+N", action: "Next value" },
                { key: "Alt+Shift+P", action: "Previous value" },
                { key: "Alt+Shift+B", action: "An action name long enough to be a translation" },
            ];
        }

        Hairline {}

        // A band of the palette, with its own rule and padding, and the same
        // band with the rule suppressed - which is how the first band is drawn.
        Zone {
            TextSmallMuted { text: "Zone - a band with its rule above it"; }
        }
        Zone {
            divided: false;
            TextSmallMuted { text: "Zone { divided: false } - the first band"; }
        }

        // The palette's own ground, at both opacities. Over the gallery's
        // background the dimmed one barely differs, and that is honest: the
        // difference only appears over somebody else's window.
        HorizontalLayout {
            spacing: Tokens.space-2;
            height: Tokens.sample-height;
            WindowSurface { }
            WindowSurface { dimmed: true; }
        }

        Hairline {}

        // The pack window's pieces (step 7). The query line in the states a
        // still picture can hold: empty, at rest, cannot be used, a wrong
        // value, and a query far too long - which must show its END, where the
        // next letter goes. The pointer and keyboard states need a pointer and
        // a focus, so `packs_appearance.rs` measures them on the real window.
        QueryField { }
        QueryField { query: "unicode"; }
        QueryField { query: "cannot be used"; enabled: false; }
        QueryField { query: "a wrong value"; invalid: true; }
        QueryField { query: "a query long enough to run past the right edge of the line - so it shows this end"; }

        // A band of a window's chrome, as the pack window's header uses it.
        ChromeBand {
            HorizontalLayout {
                TextName { text: "ChromeBand"; }
                Spacer { }
                TextSmallMuted { text: "packs: 9"; }
            }
        }

        // The pick list: selected, in use, a risk badge, a row that cannot be
        // chosen, and a name far too long - then the same list with nothing in it.
        PickList {
            selected: 0;
            current-label: "in use";
            rows: [
                { title: "Unicode & text", detail: "unicode-text . values: 34", current: true, enabled: true },
                { title: "Injections", detail: "injections . values: 40", badge: "offensive", has-badge: true, badge-risky: true, enabled: true },
                { title: "A pack whose name is far too long for one line of the list", detail: "long-name . values: 1", enabled: true },
                { title: "Broken pack", detail: "broken . problems: 3", badge: "problems: 3", has-badge: true, badge-risky: true, enabled: false },
            ];
        }
        PickList {
            empty-text: "PickList with no rows says why, in its own sentence.";
        }

        // The same list with one-line rows and a key combination at the end -
        // the shortcuts window (K5): selected and being recorded, the tester's
        // own with the longest combination the vocabulary allows, one taken by
        // another application, and an action name far too long, elided before
        // the combination rather than pushing it out.
        PickList {
            selected: 0;
            current-label: "recording";
            rows: [
                { title: "Next value", current: true, enabled: true, single-line: true, key: "Alt+Shift+...", has-key: true },
                { title: "Previous value", badge: "changed", has-badge: true, enabled: true, single-line: true, key: "Ctrl+Alt+Shift+Win+F24", has-key: true },
                { title: "Open pack search", badge: "taken", has-badge: true, badge-risky: true, enabled: true, single-line: true, key: "Alt+Shift+Space", has-key: true },
                { title: "An action name long enough to be a translation into a longer language", enabled: true, single-line: true, key: "Alt+Shift+H", has-key: true },
            ];
        }

        // The pack's name in the palette, which opens the pack window: at rest,
        // and a name far too long for its row, elided before the counter. The
        // pointer states need a pointer, so `palette_opener.rs` measures them
        // on the real palette.
        HorizontalLayout {
            spacing: Tokens.space-2;
            PickerOpener { text: "PickerOpener"; action: "Open pack search"; }
            Spacer { }
            TextCounter { text: "7 / 34"; }
        }
        HorizontalLayout {
            spacing: Tokens.space-2;
            PickerOpener { text: "A pack whose name is far too long for the palette's first band"; action: "Open pack search"; }
            Spacer { }
            TextCounter { text: "100000 / 100000"; }
        }

        Hairline {}

        // The two cases document 13 section 3 asks for by name and that never
        // appear on a screen in the author's own language: text that is far too
        // long, and text that is absent.
        TextSmallMuted { text: "the two cases that only break on someone else's machine:"; }
        TextName {
            text: "A value name long enough to leave the window, which is what the longest translation will do";
            wrap: word-wrap;
        }
        // The empty pill sits inside a row rather than directly in the column,
        // and that is not cosmetic. Placed in the column it stretched to the
        // full window width, which said more about the gallery's own layout
        // than about the component - a catalogue that misrepresents its entries
        // is worse than one that omits them.
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-2;
            Pill { text: ""; }
            TextSmallMuted { text: "an empty pill, which should never occur"; }
        }
    }
}
