// The palette: a DISPLAY driven by global shortcuts, not a form.
//
// `ux-spec.md` 2 fixes the shape, and the one requirement that decides the rest
// is that this window NEVER TAKES KEYBOARD FOCUS: if it did, the cursor would
// leave the field under test at every insertion, which is the product. So there
// is no text field here and nothing that wants the keyboard. Everything arrives
// as a property and everything leaves as a shortcut - with one exception for
// the pointer: the pack's name opens the pack window when clicked (K3.2d). A
// click reaches this window without activating it (`D62`), so it takes nothing
// from the field under test.
//
// # Two axes and a bar, not five states
//
// `OBS-94` settled this for the core and it holds for the window: clipboard mode
// is a SECOND AXIS, not another state. So:
//
//     compact          the tester's choice: only the pack band, background dimmed
//     clipboard-mode   a standing condition, visible in both
//     hints            the first twenty uses, and on demand afterwards
//
// 🔴 Nothing here ever hides the WINDOW. `OBS-80` measured that `hide()` and
// `show()` destroy the window on Windows and lose `WS_EX_NOACTIVATE` with it, so
// the states are transparency and which bands are visible - never the window.
//
// # Why the window no longer shrinks by itself (D83)
//
// Until D83 the palette dimmed four seconds after every value and dropped every
// band but the pack, which is what `ux-spec.md` 2 drew. In use it was the wrong
// design: the window jumped from a full panel to one line under the tester's
// eyes, and what had just gone out was gone before they looked back. So the
// value stays until the next one replaces it, the window never gets shorter on
// its own, and the compact form is a shortcut the tester presses.
//
// # What the compact state may show, and why it is so short
//
// D53: at the dimmed alpha, `text-muted` no longer holds 4.5:1 over a white
// window lying under the palette - it would need 0.96 - so it MUST NOT appear
// while the palette is dimmed. Every muted role therefore lives inside a band
// gated on `compact`, and `palette_appearance.rs` measures the rendered pixels
// rather than trusting this sentence. The message band stays in both states:
// rule 1 of this project forbids a palette that goes quiet because the tester
// made it small, and its text is not muted.
//
// # One zone from the sketch in `ux-spec.md` 2 is absent, on purpose
//
// The TARGET band (application, window title, field kind). `nkb-sys` knows one
// thing about the target today, its window handle, and nothing that could be
// written next to a person. A band with no source would be a promise, so it
// waits for `TargetInspector` - `OBS-91`. Named here rather than left as a gap
// the next session rediscovers.
//
// Until 2026-09-23 this said the preview and its shape line were absent too.
// They arrived with C4b-1 (`D64`) and the sentence stayed behind for a day.

import {
    Tokens,
    TextName,
    TextBody,
    TextMono,
    TextPreview,
    TextSmallMuted,
    TextCounter,
    Spacer,
    Pill,
    Zone,
    HintRow,
    HintBar,
    Marker,
    MarkerRow,
    WindowSurface,
    PickerOpener,
} from "../components.slint";

export component Palette inherits Window {
    // ---- what the window is ------------------------------------------------
    // Every string below is finished text from `nkb-adapters::i18n`. Assembling
    // one here would mean a quoted string in a view, which `ui_guard.rs`
    // refuses - untouchable rule 9, D58.
    in property <string> window-title;

    // ---- the pack band, the only one the compact state shows ----------------
    in property <string> pack;
    in property <string> counter;

    // ---- the value band before the first value ------------------------------
    // Finished text naming the shortcut that sends one. GUI rule 3: a view with
    // data has an empty state, and this band is there from the first frame.
    in property <string> no-value;

    // ---- the value band ----------------------------------------------------
    in property <string> value-name;
    in property <string> value-reference;
    in property <string> value-counts;
    // The value as a person can see it: invisible characters stand in as
    // `nkb_core::preview::MARKER`. `ux-spec.md` 2 calls this the line without
    // which the whole unicode category is unreportable.
    in property <string> value-preview;
    // Said only when the preview is a fragment. Never implied: a fragment
    // presented as the whole is the silence rule 1 forbids.
    in property <string> value-elided;
    // Said only when the preview draws a character the shipped typeface does
    // not guarantee (`D52`, `D66`). What the tester sees of that character
    // depends on the machine, and the tool cannot tell what the machine drew -
    // so it says where its own promise ends.
    in property <string> value-not-guaranteed;
    // What the value is made of, already joined into one line by `i18n`.
    in property <string> value-shape;
    // 🔴 Two switches rather than comparing the strings to "" in the view, and
    // that is not a detour: `ui_guard.rs` refuses a quoted string in a view
    // (untouchable rule 9, D58) and it caught exactly this - the empty literal
    // is not a sentence, but an exception carved into a guard is a door, so the
    // view gets a boolean instead. The same shape as `has-value` above.
    in property <bool> has-elided;
    in property <bool> has-not-guaranteed;
    in property <bool> has-shape;
    in property <[Marker]> markers;

    // ---- what the tool has to say ------------------------------------------
    in property <[string]> messages;

    // ---- the standing bar --------------------------------------------------
    in property <string> clipboard-mode-label;

    // ---- the hint bar ------------------------------------------------------
    in property <[HintRow]> hints;

    // ---- state -------------------------------------------------------------
    // The tester's choice, made with a shortcut and never by a timer (D83).
    in property <bool> compact;
    // Whether a value has gone out yet. Before the first one the value band
    // shows its empty state instead of three empty lines and a row of no
    // markers - `ux-spec.md` 5.1.
    in property <bool> has-value;
    // Values go through the clipboard and the tester pastes them. Named after
    // the glossary (`ClipboardMode`), never "degraded": `ux-spec.md` 8 forbids
    // presenting this mode as a failure, in words or otherwise.
    in property <bool> clipboard-mode;
    in property <bool> hints-visible: true;
    // Whether the system permits translucency at all (D53). Separate from
    // `showing` because it is the system's answer, not the palette's state.
    in property <bool> translucency-allowed: true;

    // ---- height ------------------------------------------------------------
    // The tallest the expanded palette has been since it was last expanded.
    // Kept by the worker (`live.rs`), because remembering is logic and a view
    // holds none: without it, a value with a one-line preview after one with a
    // three-line preview would pull the window's bottom edge up under the
    // tester's eyes - the jump D83 removed, only smaller.
    in property <length> height-floor;
    // What the content asks for right now.
    out property <length> content-height: surface.preferred-height;
    // Said whenever that changes, so Rust can move the floor.
    //
    // 🔴 An event and not a value Rust reads, and the reason is measured: bands
    // behind `if` are built when the window is next drawn, not when a property
    // is read (`slint.md` 2.27). Read straight after the properties were set,
    // this height still lacks the band that was just switched on - 105 px for a
    // one-letter value and for a three-hundred-letter one alike.
    callback content-height-changed(length);
    changed content-height => {
        root.content-height-changed(self.content-height);
    }
    // Asks for the pack window: a click on the pack's name, and Rust invokes
    // the same callback when the shortcut arrives on the worker - so both ways
    // in reach the same Rust on the main thread, and the view holds no handler
    // body.
    callback open-packs <=> opener.clicked;
    // What the click does, in the hint bar's words, for UI Automation.
    in property <string> open-packs-label;

    title: root.window-title;
    // The colour lives on the surface below, so that the palette can have
    // rounded corners - a window background cannot.
    background: transparent;
    always-on-top: true;
    width: Tokens.palette-width;
    // The palette follows its own content. Measured 2026-09-22: Slint does NOT
    // resize a window when what is inside it changes, so without this binding
    // the compact state would be one line of text at the top of a panel the size
    // of the expanded one. Expanded, it never gets shorter than the floor.
    height: root.compact ? surface.preferred-height : max(root.height-floor, surface.preferred-height);

    surface := WindowSurface {
        dimmed: root.compact && root.translucency-allowed;

        VerticalLayout {
            // Packed to the top: the window sizes to its content, and where the
            // system gives it more room the bands must not stretch to fill it.
            alignment: start;

            // The pack and the counter. No rule above it: it is the first band,
            // and at rest it is the only one.
            Zone {
                divided: false;
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    // A pack name is somebody else's string and can be any
                    // length. Elided rather than wrapped: the counter beside
                    // it must keep its place, and a band that grows a line
                    // because of a long name moves everything below it. A click
                    // on it opens the pack window.
                    opener := PickerOpener {
                        text: root.pack;
                        action: root.open-packs-label;
                    }
                    Spacer { }
                    TextCounter {
                        text: root.counter;
                    }
                }
            }

            // The standing bar. Permanent by design: a message that disappears
            // stops existing while the limitation stays - `ux-spec.md` 2.
            //
            // Right under the pack band, and that is a correction from the
            // first render (D71): placed after the messages it stood under the
            // counter at rest and some two hundred pixels lower once a value
            // went out - a standing condition that JUMPS between the two states
            // of the window, which GUI rule 3 forbids. Here it holds one place.
            //
            // The ACCENT tint, not the risk one, and that is the point of the
            // colour here (D71). Risk is what `offensive` wears, and clipboard
            // mode is a full route rather than a failure - `ux-spec.md` 8 says so
            // in words, and a bar in the risk colour would say the opposite
            // without any. The gallery drew this pill in accent from the start.
            if root.clipboard-mode: Zone {
                HorizontalLayout {
                    alignment: start;
                    Pill {
                        text: root.clipboard-mode-label;
                        tint: Tokens.accent;
                    }
                }
            }

            // Before the first value: what to do to send one.
            if !root.compact && !root.has-value: Zone {
                TextBody {
                    text: root.no-value;
                    wrap: word-wrap;
                }
            }

            // The value that went out last. It stays until the next one.
            if !root.compact && root.has-value: Zone {
                TextName {
                    text: root.value-name;
                    wrap: word-wrap;
                }
                // The preview, in the order the sketch draws: name, preview,
                // shape, counters.
                //
                // ⚠️ ONE text element rather than coloured segments, and the
                // reason is the layout engine: colouring the markers apart from
                // the value would mean one element per segment, and a horizontal
                // layout in Slint does not wrap - a hundred-code-point value at
                // preview size would run off the window. `TextPreviewInvisible`
                // therefore stays unused for now. The marker is told apart by its
                // SHAPE, which is a visible box, rather than by colour.
                TextPreview {
                    text: root.value-preview;
                    wrap: char-wrap;
                }
                if root.has-elided: TextSmallMuted {
                    text: root.value-elided;
                }
                // Under the preview because it qualifies the preview, and in
                // the muted role because it is a note about the tool's display
                // rather than a fact about the value. Wrapped: a list of code
                // points is somebody else's data and has no fixed length.
                if root.has-not-guaranteed: TextSmallMuted {
                    text: root.value-not-guaranteed;
                    wrap: word-wrap;
                }
                if root.has-shape: TextBody {
                    text: root.value-shape;
                    wrap: word-wrap;
                }
                // Both wrap, and both did not until 2026-09-23: a render with the
                // shipped `len-100000` cut the counters off at the window's edge,
                // mid-word. A reference is up to 89 characters with no space in
                // it (`pack-format.md` 7), so it breaks anywhere. The counters
                // have spaces, so they break between words.
                TextMono {
                    text: root.value-reference;
                    wrap: char-wrap;
                }
                TextMono {
                    text: root.value-counts;
                    wrap: word-wrap;
                }
                MarkerRow {
                    markers: root.markers;
                }
            }

            // What the tool has to say about it. Rule 1 of this project: a run
            // that did less than it promised says so, and this band is where
            // the palette says it - in the compact state as well, because a
            // palette the tester made small must not go quiet.
            if root.messages.length > 0: Zone {
                for message in root.messages: TextBody {
                    text: message;
                    wrap: word-wrap;
                }
            }

            // The hints. Hidden in the compact state, which is meant to take
            // little room and no attention.
            if root.hints-visible && !root.compact: Zone {
                HintBar {
                    rows: root.hints;
                }
            }
        }
    }
}
