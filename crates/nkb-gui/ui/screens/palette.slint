// The palette: a DISPLAY driven by global shortcuts, not a form.
//
// `ux-spec.md` 2 fixes the shape, and the one requirement that decides the rest
// is that this window NEVER TAKES KEYBOARD FOCUS: if it did, the cursor would
// leave the field under test at every insertion, which is the product. So there
// is no text field here and nothing that wants the keyboard. Everything arrives
// as a property and everything leaves as a shortcut - with the pointer as the
// one exception: the pack's name and the next band's heading open the value
// window (K3.2d, UX2), the link under the hints opens the shortcuts window
// (K5.5), two Copy buttons put a value on the clipboard (D98), one button
// at a time turns clipboard mode on or off (D99), and the button at the end of
// the pack band collapses or expands the palette (D100). A click
// reaches this window without activating it (`D62`), so it takes nothing from
// the field under test.
//
// # Two axes and a bar, not five states
//
// `OBS-94` settled this for the core and it holds for the window: clipboard mode
// is a SECOND AXIS, not another state. So:
//
//     compact          the tester's choice: only the pack band, background dimmed
//     clipboard-mode   a standing condition, visible in both
//     hints            the first twenty uses, and on demand afterwards
//
// 🔴 Nothing here ever hides the WINDOW. `OBS-80` measured that `hide()` and
// `show()` destroy the window on Windows and lose `WS_EX_NOACTIVATE` with it, so
// the states are transparency and which bands are visible - never the window.
//
// # Why the window no longer shrinks by itself (D83)
//
// Until D83 the palette dimmed four seconds after every value and dropped every
// band but the pack, which is what `ux-spec.md` 2 drew. In use it was the wrong
// design: the window jumped from a full panel to one line under the tester's
// eyes, and what had just gone out was gone before they looked back. So the
// value stays until the next one replaces it, the window never gets shorter on
// its own, and the compact form is a shortcut the tester presses.
//
// # What the compact state may show, and why it is so short
//
// D53: at the dimmed alpha, `text-muted` no longer holds 4.5:1 over a white
// window lying under the palette - it would need 0.96 - so it MUST NOT appear
// while the palette is dimmed. Every muted role therefore lives inside a band
// gated on `compact`, and `palette_appearance.rs` measures the rendered pixels
// rather than trusting this sentence. The message band stays in both states:
// rule 1 of this project forbids a palette that goes quiet because the tester
// made it small, and its text is not muted.
//
// # One zone from the sketch in `ux-spec.md` 2 is absent, on purpose
//
// The TARGET band (application, window title, field kind). `nkb-sys` knows one
// thing about the target today, its window handle, and nothing that could be
// written next to a person. A band with no source would be a promise, so it
// waits for `TargetInspector` - `OBS-91`. Named here rather than left as a gap
// the next session rediscovers.
//
// Until 2026-09-23 this said the preview and its shape line were absent too.
// They arrived with C4b-1 (`D64`) and the sentence stayed behind for a day.

import {
    Tokens,
    TextName,
    TextBody,
    TextMono,
    TextPreview,
    TextSmallMuted,
    TextCounter,
    Spacer,
    Pill,
    Zone,
    HintRow,
    HintBar,
    Marker,
    MarkerRow,
    WindowSurface,
    PickerOpener,
    ProgressBar,
    SmallButton,
} from "../components.slint";

// Which value a Copy button copies: the pack's identifier and the value's.
// Identifiers rather than a position, because the worker may have moved the
// sequence between the click and its turn, and an identifier still names the
// value the tester saw - or none (`D98`). Opaque to the view: it holds them
// and never reads them.
export struct ValueKey {
    pack: string,
    value: string,
}

export component Palette inherits Window {
    // ---- what the window is ------------------------------------------------
    // Every string below is finished text from `nkb-adapters::i18n`. Assembling
    // one here would mean a quoted string in a view, which `ui_guard.rs`
    // refuses - untouchable rule 9, D58.
    in property <string> window-title;

    // ---- the pack band, the only one the compact state shows ----------------
    in property <string> pack;
    in property <string> counter;

    // ---- the value band before the first value ------------------------------
    // Finished text naming the shortcut that sends one. GUI rule 3: a view with
    // data has an empty state, and this band is there from the first frame.
    in property <string> no-value;

    // ---- the next value (UX-GUI-001) ---------------------------------------
    // What the next press sends, shown BEFORE it goes, so the tester does not
    // type blind - a length bomb or an offensive value included. Every string is
    // finished text from `i18n`. Which value it is comes from the core's
    // `Sequence::upcoming`, which a test holds to what the press really does.
    in property <bool> has-next;
    in property <string> next-heading;
    // False at the end of a pack, where the next press only says so and the
    // band is its heading alone.
    in property <bool> next-has-value;
    in property <string> next-name;
    in property <string> next-preview;
    in property <[Marker]> next-markers;

    // ---- the value band ----------------------------------------------------
    // Its heading, now that a second value stands above it.
    in property <string> last-sent-label;
    in property <string> value-name;
    // Where the value was typed, read at the press (UX8, `D104`): the program
    // and the kind of control. Never for a value put on the clipboard.
    in property <string> value-sent-to;
    in property <bool> has-sent-to;
    in property <string> value-reference;
    in property <string> value-counts;
    // The value as a person can see it: invisible characters stand in as
    // `nkb_core::preview::MARKER`. `ux-spec.md` 2 calls this the line without
    // which the whole unicode category is unreportable.
    in property <string> value-preview;
    // Said only when the preview is a fragment. Never implied: a fragment
    // presented as the whole is the silence rule 1 forbids.
    in property <string> value-elided;
    // Said only when the preview draws a character the shipped typeface does
    // not guarantee (`D52`, `D66`). What the tester sees of that character
    // depends on the machine, and the tool cannot tell what the machine drew -
    // so it says where its own promise ends.
    in property <string> value-not-guaranteed;
    // What the value is made of, already joined into one line by `i18n`.
    in property <string> value-shape;
    // 🔴 Two switches rather than comparing the strings to "" in the view, and
    // that is not a detour: `ui_guard.rs` refuses a quoted string in a view
    // (untouchable rule 9, D58) and it caught exactly this - the empty literal
    // is not a sentence, but an exception carved into a guard is a door, so the
    // view gets a boolean instead. The same shape as `has-value` above.
    in property <bool> has-elided;
    in property <bool> has-not-guaranteed;
    in property <bool> has-shape;
    in property <[Marker]> markers;

    // ---- the Copy buttons (UX-GUI-003, D98) ---------------------------------
    // One beside the next value and one beside the last value sent: each
    // copies the value drawn in its band, for the tester to paste by hand. The
    // word on both, and what each does in UI Automation's words.
    in property <string> copy-label;
    in property <string> copy-next-action;
    in property <string> copy-last-action;
    // Which value each copies - set with the band it stands in, from the same
    // view, so a click copies the value on screen. Rust reads them back on the
    // click: the view holds no logic.
    in property <ValueKey> next-key;
    in property <ValueKey> last-key;
    // ⚠️ Declared, not aliases like `open-packs`: both buttons stand in bands
    // behind `if`, and an element behind `if` cannot be named from here. Each
    // click only hands on to its callback - one call, no logic.
    callback copy-next();
    callback copy-last();

    // ---- what the tool has to say ------------------------------------------
    in property <[string]> messages;

    // ---- the standing bar --------------------------------------------------
    in property <string> clipboard-mode-label;

    // ---- clipboard mode on and off (UX-GUI-010, D99) ------------------------
    // Two clicks and no shortcut: each new global shortcut is a collision in
    // somebody's application (`main.rs`, D71). On: a button under the hint
    // bar. Off: a button on the standing bar, beside the words that say the
    // mode is on. The tester's MODE, not the window's: false while only the
    // window in front is on the clipboard (D72), which is not a mode the
    // tester chose and not one a click could end.
    in property <bool> clipboard-mode-on;
    in property <string> use-clipboard-label;
    in property <string> turn-off-label;
    in property <string> turn-off-action;
    // ⚠️ Declared, not aliases: both buttons stand in bands behind `if`. Each
    // click only hands on to its callback - one call, no logic.
    callback use-clipboard();
    callback turn-off-clipboard();

    // ---- how a typed value meets the field (UX-GUI-005, D101) ---------------
    // What happens now - the line cleared first, or the value at the cursor -
    // and the button's words, which name the other way. Both finished text
    // from `i18n`, chosen in Rust from the worker's state: the view does not
    // decide which sentence is true.
    in property <string> clearing-state;
    in property <string> clearing-switch;
    // A click on the button. The worker holds the choice and remembers it.
    callback switch-clearing();

    // ---- a send in progress (W3, D96, OBS-160) ------------------------------
    // Until this band a long send left the palette showing what it showed
    // before, for minutes, with nothing to say that Escape stops it. Every
    // string is finished text from `i18n`, and the share of the bar is computed
    // and clamped in the worker - the view draws, it does not count.
    in property <bool> sending;
    in property <string> sending-label;
    in property <string> sending-counter;
    in property <float> sending-fraction;
    in property <string> sending-hint;

    // ---- the hint bar ------------------------------------------------------
    in property <[HintRow]> hints;

    // ---- state -------------------------------------------------------------
    // The tester's choice, made with a shortcut or the button in the pack band
    // and never by a timer (D83).
    in property <bool> compact;
    // The button's two words: what a click does in each state (`UX-GUI-004`).
    in property <string> collapse-label;
    in property <string> expand-label;
    // A click on it. The worker owns the switch and remembers it (`D84`), so
    // the click only asks - the same way as the shortcut.
    callback toggle-compact();
    // Whether a value has gone out yet. Before the first one the value band
    // shows its empty state instead of three empty lines and a row of no
    // markers - `ux-spec.md` 5.1.
    in property <bool> has-value;
    // Values go through the clipboard and the tester pastes them. Named after
    // the glossary (`ClipboardMode`), never "degraded": `ux-spec.md` 8 forbids
    // presenting this mode as a failure, in words or otherwise.
    in property <bool> clipboard-mode;
    in property <bool> hints-visible: true;
    // Whether the system permits translucency at all (D53). Separate from
    // `showing` because it is the system's answer, not the palette's state.
    in property <bool> translucency-allowed: true;

    // ---- height ------------------------------------------------------------
    // The tallest the expanded palette has been since it was last expanded.
    // Kept by the worker (`live.rs`), because remembering is logic and a view
    // holds none: without it, a value with a one-line preview after one with a
    // three-line preview would pull the window's bottom edge up under the
    // tester's eyes - the jump D83 removed, only smaller.
    in property <length> height-floor;
    // What the content asks for right now.
    out property <length> content-height: surface.preferred-height;
    // Said whenever that changes, so Rust can move the floor.
    //
    // 🔴 An event and not a value Rust reads, and the reason is measured: bands
    // behind `if` are built when the window is next drawn, not when a property
    // is read (`slint.md` 2.27). Read straight after the properties were set,
    // this height still lacks the band that was just switched on - 105 px for a
    // one-letter value and for a three-hundred-letter one alike.
    callback content-height-changed(length);
    changed content-height => {
        root.content-height-changed(self.content-height);
    }
    // Asks for the pack window: a click on the pack's name, and Rust invokes
    // the same callback when the shortcut arrives on the worker - so both ways
    // in reach the same Rust on the main thread, and the view holds no handler
    // body.
    callback open-packs <=> opener.clicked;
    // What the click does, in the hint bar's words, for UI Automation.
    in property <string> open-packs-label;
    // Asks for the shortcuts window (step 7, K5.5) - a click on the link under
    // the hint bar. No eleventh global shortcut: each one is a collision in
    // somebody's application (`ux-spec.md` 5.4).
    //
    // ⚠️ Declared, not an alias like `open-packs`: the link stands in a band
    // behind `if`, and an element behind `if` cannot be named from here. The
    // link's own click only hands on to this callback - one call, no logic.
    callback open-shortcuts();
    // The link's words, which are also what the click does.
    in property <string> shortcuts-link;

    title: root.window-title;
    // The colour lives on the surface below, so that the palette can have
    // rounded corners - a window background cannot.
    background: transparent;
    always-on-top: true;
    width: Tokens.palette-width;
    // The palette follows its own content. Measured 2026-09-22: Slint does NOT
    // resize a window when what is inside it changes, so without this binding
    // the compact state would be one line of text at the top of a panel the size
    // of the expanded one. Expanded, it never gets shorter than the floor.
    height: root.compact ? surface.preferred-height : max(root.height-floor, surface.preferred-height);

    surface := WindowSurface {
        dimmed: root.compact && root.translucency-allowed;

        VerticalLayout {
            // Packed to the top: the window sizes to its content, and where the
            // system gives it more room the bands must not stretch to fill it.
            alignment: start;

            // The pack and the counter. No rule above it: it is the first band,
            // and at rest it is the only one.
            Zone {
                divided: false;
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    // A pack name is somebody else's string and can be any
                    // length. Elided rather than wrapped: the counter beside
                    // it must keep its place, and a band that grows a line
                    // because of a long name moves everything below it. A click
                    // on it opens the value window, and the mark after it says
                    // so with the pointer elsewhere (`UX-GUI-015`).
                    //
                    // Centred on the button's row, like every heading beside a
                    // button in this window (`slint.md` 2.43).
                    VerticalLayout {
                        alignment: center;
                        opener := PickerOpener {
                            text: root.pack;
                            action: root.open-packs-label;
                            chevron: true;
                        }
                    }
                    Spacer { }
                    VerticalLayout {
                        alignment: center;
                        TextCounter {
                            text: root.counter;
                        }
                    }
                    // Collapse and expand, in BOTH states and in one place
                    // (`UX-GUI-004`): until this button the compact palette
                    // said nothing about how to get the rest back, and it
                    // starts compact on the next run when the tester left it
                    // so. The word says what a click does now. A click reaches
                    // the palette without activating it (`D62`). Faded while a
                    // value goes, like every button here: the worker answers a
                    // click between presses, so it would land after the send.
                    SmallButton {
                        text: root.compact ? root.expand-label : root.collapse-label;
                        action: root.compact ? root.expand-label : root.collapse-label;
                        enabled: !root.sending;
                        clicked => {
                            root.toggle-compact();
                        }
                    }
                }
            }

            // The standing bar. Permanent by design: a message that disappears
            // stops existing while the limitation stays - `ux-spec.md` 2.
            //
            // Right under the pack band, and that is a correction from the
            // first render (D71): placed after the messages it stood under the
            // counter at rest and some two hundred pixels lower once a value
            // went out - a standing condition that JUMPS between the two states
            // of the window, which GUI rule 3 forbids. Here it holds one place.
            //
            // The ACCENT tint, not the risk one, and that is the point of the
            // colour here (D71). Risk is what `offensive` wears, and clipboard
            // mode is a full route rather than a failure - `ux-spec.md` 8 says so
            // in words, and a bar in the risk colour would say the opposite
            // without any. The gallery drew this pill in accent from the start.
            //
            // The way out stands on the bar itself (D99): the tester who reads
            // that the mode is on finds how to end it in the same place. In
            // both states of the window, like the bar - the button's words are
            // a role the resting state may show (D53). Faded while a value goes:
            // the route cannot change under a value in flight.
            if root.clipboard-mode: Zone {
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    // Centred on the button's row, as the next band's heading
                    // is beside its Copy (`slint.md` 2.43).
                    VerticalLayout {
                        alignment: center;
                        Pill {
                            text: root.clipboard-mode-label;
                            tint: Tokens.accent;
                        }
                    }
                    Spacer { }
                    if root.clipboard-mode-on: SmallButton {
                        text: root.turn-off-label;
                        action: root.turn-off-action;
                        enabled: !root.sending;
                        clicked => {
                            root.turn-off-clipboard();
                        }
                    }
                }
            }

            // A send in progress. In BOTH states, like the standing bar above it:
            // a tester who made the palette small must still be told that a send
            // is running and how to stop it, so every role here is one the
            // resting state may show (D53) - no muted text, the hint bar's own
            // look included. Right under the pack band and the bar, so it holds
            // one place whatever the bands below are doing.
            if root.sending: Zone {
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    TextBody {
                        text: root.sending-label;
                        overflow: elide;
                    }
                    Spacer { }
                    TextCounter {
                        text: root.sending-counter;
                    }
                }
                ProgressBar {
                    fraction: root.sending-fraction;
                }
                TextBody {
                    text: root.sending-hint;
                    wrap: word-wrap;
                }
            }

            // What the next press sends (UX-GUI-001), above the value that went
            // out last. One line each, ELIDED rather than wrapped: the band
            // changes with every press, and a band that grew and shrank with
            // the value would move everything below it (D83). The whole value
            // is drawn in the band below once it is sent. Expanded only - the
            // heading is muted (D53). Not while a send runs: which value comes
            // next depends on how the one in flight ends.
            if !root.compact && root.has-next && !root.sending: Zone {
                // The heading opens the value window on this value (UX2): the
                // way to choose another one starts where the tester reads which
                // one is next. The pack's name and the shortcut open the same
                // window through the same callback.
                //
                // Copy at the other end of the heading's row, where the value
                // band below has its own: the two buttons stand in one column,
                // each at the top of the value it copies (D98). Not at the end
                // of a pack - there is no value to copy then.
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    // Centred on the button's row: the heading's height is its
                    // own text, and a layout puts such an element at the top -
                    // four pixels above the word beside it, in the first render.
                    VerticalLayout {
                        alignment: center;
                        PickerOpener {
                            text: root.next-heading;
                            action: root.open-packs-label;
                            chevron: true;
                            clicked => {
                                root.open-packs();
                            }
                        }
                    }
                    Spacer { }
                    if root.next-has-value: SmallButton {
                        text: root.copy-label;
                        action: root.copy-next-action;
                        clicked => {
                            root.copy-next();
                        }
                    }
                }
                // The risk beside the name rather than on a row of its own: the
                // palette stays on top of the application under test, and a row
                // spent on one pill is height taken from it (second look at the
                // first render). The name gives way, the pill does not.
                // The name in the value band's own role, so the two values on
                // screen read alike and the heading above stays the smaller
                // line (second look at the render: in the body role the name
                // and the heading were one style).
                if root.next-has-value: HorizontalLayout {
                    spacing: Tokens.space-2;
                    TextName {
                        text: root.next-name;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    MarkerRow {
                        markers: root.next-markers;
                    }
                }
                if root.next-has-value: TextPreview {
                    text: root.next-preview;
                    overflow: elide;
                }
            }

            // Before the first value: what to do to send one.
            if !root.compact && !root.has-value: Zone {
                TextBody {
                    text: root.no-value;
                    wrap: word-wrap;
                }
            }

            // The value that went out last. It stays until the next one.
            if !root.compact && root.has-value: Zone {
                // While a value goes, this band shows THAT value, not the last
                // one sent, and the button's key still names the last one. So it
                // cannot be used then - faded in place rather than taken away,
                // because a control that vanishes under the pointer moves the
                // row it stood in (GUI rule 3).
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    TextSmallMuted {
                        text: root.last-sent-label;
                    }
                    Spacer { }
                    SmallButton {
                        text: root.copy-label;
                        action: root.copy-last-action;
                        enabled: !root.sending;
                        clicked => {
                            root.copy-last();
                        }
                    }
                }
                TextName {
                    text: root.value-name;
                    wrap: word-wrap;
                }
                // Under the name, because "which value went where" is the
                // question this band answers - and a tester who switched
                // windows a moment before the press sees it here, not in a
                // ticket a day later (`UX-GUI-013`).
                if root.has-sent-to: TextBody {
                    text: root.value-sent-to;
                    wrap: word-wrap;
                }
                // The preview, in the order the sketch draws: name, preview,
                // shape, counters.
                //
                // ⚠️ ONE text element rather than coloured segments, and the
                // reason is the layout engine: colouring the markers apart from
                // the value would mean one element per segment, and a horizontal
                // layout in Slint does not wrap - a hundred-code-point value at
                // preview size would run off the window. `TextPreviewInvisible`
                // therefore stays unused for now. The marker is told apart by its
                // SHAPE, which is a visible box, rather than by colour.
                TextPreview {
                    text: root.value-preview;
                    wrap: char-wrap;
                }
                if root.has-elided: TextSmallMuted {
                    text: root.value-elided;
                }
                // Under the preview because it qualifies the preview, and in
                // the muted role because it is a note about the tool's display
                // rather than a fact about the value. Wrapped: a list of code
                // points is somebody else's data and has no fixed length.
                if root.has-not-guaranteed: TextSmallMuted {
                    text: root.value-not-guaranteed;
                    wrap: word-wrap;
                }
                if root.has-shape: TextBody {
                    text: root.value-shape;
                    wrap: word-wrap;
                }
                // Both wrap, and both did not until 2026-09-23: a render with the
                // shipped `len-100000` cut the counters off at the window's edge,
                // mid-word. A reference is up to 89 characters with no space in
                // it (`pack-format.md` 7), so it breaks anywhere. The counters
                // have spaces, so they break between words.
                TextMono {
                    text: root.value-reference;
                    wrap: char-wrap;
                }
                TextMono {
                    text: root.value-counts;
                    wrap: word-wrap;
                }
                MarkerRow {
                    markers: root.markers;
                }
            }

            // What the tool has to say about it. Rule 1 of this project: a run
            // that did less than it promised says so, and this band is where
            // the palette says it - in the compact state as well, because a
            // palette the tester made small must not go quiet.
            if root.messages.length > 0: Zone {
                for message in root.messages: TextBody {
                    text: message;
                    wrap: word-wrap;
                }
            }

            // The hints. Hidden in the compact state, which is meant to take
            // little room and no attention.
            if root.hints-visible && !root.compact: Zone {
                HintBar {
                    rows: root.hints;
                }
                // How a typed value meets the field (UX-GUI-005, D101): what
                // happens now on the left, the other way as a button on the
                // right - the shape of the clipboard row below it. Said before
                // the first value, so the tester learns that the line is
                // cleared before it happens, not from the marker after. Only
                // while values are typed: the clipboard route clears nothing.
                if !root.clipboard-mode-on: HorizontalLayout {
                    spacing: Tokens.space-2;
                    VerticalLayout {
                        alignment: center;
                        TextBody {
                            text: root.clearing-state;
                            overflow: elide;
                        }
                    }
                    Spacer { }
                    SmallButton {
                        text: root.clearing-switch;
                        action: root.clearing-switch;
                        enabled: !root.sending;
                        clicked => {
                            root.switch-clearing();
                        }
                    }
                }
                // Under the shortcuts it changes, and in the same component
                // as the pack's name above: a link in the palette looks and
                // answers the pointer one way (GUI rule 2).
                //
                // Clipboard mode is turned on at the other end of the same row
                // (D99): a button, not a link, because it changes how values
                // travel rather than opening a window. Only while values are
                // typed - in the mode, its way out stands on the bar above.
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    VerticalLayout {
                        alignment: center;
                        PickerOpener {
                            text: root.shortcuts-link;
                            action: root.shortcuts-link;
                            clicked => {
                                root.open-shortcuts();
                            }
                        }
                    }
                    Spacer { }
                    if !root.clipboard-mode-on: SmallButton {
                        text: root.use-clipboard-label;
                        action: root.use-clipboard-label;
                        enabled: !root.sending;
                        clicked => {
                            root.use-clipboard();
                        }
                    }
                }
            }
        }
    }
}
