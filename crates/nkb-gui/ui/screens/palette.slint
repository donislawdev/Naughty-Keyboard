// The palette: a DISPLAY driven by global shortcuts, not a form.
//
// `ux-spec.md` 2 fixes the shape, and the one requirement that decides the rest
// is that this window NEVER TAKES KEYBOARD FOCUS: if it did, the cursor would
// leave the field under test at every insertion, which is the product. So there
// is no text field here and nothing that wants the keyboard. Everything arrives
// as a property and everything leaves as a shortcut - with the pointer as the
// one exception: the pack's name opens the value window (K3.2d), the link
// under the switches opens the shortcuts window (K5.5), two Copy buttons put a
// value on the clipboard (D98), two switches choose how values travel and how
// they meet the field (D99, D101, the owner's point 2 of 2026-10-07), the
// heading of the last value sent folds it (point 7), and the button in the
// header collapses or expands the palette (D100). A click reaches this window
// without activating it (`D62`), so it takes nothing from the field under test.
//
// # The frame every window stands in (`D110`)
//
// The palette is a window like the others: a header with its title - the pack
// - and what belongs beside it, the content in sections, the keys in a footer,
// and what the tool has to say in a status line at the very bottom
// (`components/frame.slint`). Until 2026-10-07 it had no header, a narrower
// gutter and its keys among the content, and the owner saw a different program
// in each window (point 4).
//
//     header      the pack, which opens the value window · the counter ·
//                 Collapse or Expand
//     Next        what the next press sends - one line each, so the band is as
//                 tall at the end of a pack as anywhere else
//     Last sent   folded to one row, unfolded by the tester
//     settings    how values travel, how they meet the field, the link to the
//                 shortcuts window
//     footer      the keys
//     status      the standing clipboard bar where the switch cannot say it, a
//                 send in progress, every sentence the tool has to say, and
//                 before the first value how to send one
//
// # Nothing the tester clicks moves (the owner's point 1)
//
// Every band above the footer is as tall whatever happens: the next value is
// elided rather than wrapped, the last value sent is folded unless the tester
// opens it, and before the first value its row stands faded rather than
// missing. Everything that comes and goes - a sentence, a send in progress, the
// standing bar - stands in the status line, below everything else, so it moves
// only the window's bottom edge. Until 2026-10-07 a click on "Clipboard" put
// the standing bar and a three-line sentence ABOVE the switch, and a click on
// "Change shortcuts" a sentence above the link, and both jumped away from under
// the pointer.
//
// # The window is as tall as its content (the owner's point 2, `D110`)
//
// `D83` kept the expanded palette at the tallest it had been, so that a short
// value after a long one would not pull the bottom edge up. With the sentences
// in the middle of the window that held the edge but not the content: the
// bands below jumped up anyway, and the room they left stayed empty at the
// bottom - and grew with every sentence, the owner measured it by clicking
// "Change shortcuts" a few times. Now a sentence can only be at the bottom, so
// the window simply follows its content, and what `D83` is really about still
// holds: the value stays until the next one, no timer changes anything, and
// collapsing is the tester's alone.
//
// # Two axes, not five states
//
// `OBS-94` settled this for the core and it holds for the window: clipboard mode
// is a SECOND AXIS, not another state. So:
//
//     compact          the tester's choice: the header and the status line,
//                      the ground dimmed
//     clipboard-mode   a standing condition, said in both
//
// 🔴 Nothing here ever hides the WINDOW. `OBS-80` measured that `hide()` and
// `show()` destroy the window on Windows and lose `WS_EX_NOACTIVATE` with it, so
// the states are transparency and which bands are visible - never the window.
//
// # What the compact state may show, and why it is so short
//
// D53: at the dimmed alpha, `text-muted` no longer holds 4.5:1 over a white
// window lying under the palette - it would need 0.96 - so it MUST NOT appear
// while the palette is dimmed. Every muted role therefore lives inside a band
// gated on `compact`, and `palette_appearance.rs` measures the rendered pixels
// rather than trusting this sentence. The status line stays in both states:
// rule 1 of this project forbids a palette that goes quiet because the tester
// made it small, and its text is not muted.
//
// # One zone from the sketch in `ux-spec.md` 2 is a line, not a band
//
// The TARGET (application, window title, field kind) has no band: what the
// tool knows of it since UX8 (`D104`) - the program's file name and the kind of
// control - is one line under the last value's name. The window title is not
// read (`D104`).

import {
    Tokens,
    TextBody,
    TextCounter,
    Spacer,
    Pill,
    Zone,
    HintRow,
    HintBar,
    Marker,
    WindowFrame,
    WindowHeader,
    WindowFooter,
    WindowStatus,
    ProgressBar,
    SmallButton,
    NextBand,
    LastSentBand,
    SwitchesBand,
} from "../components.slint";

// Which value a Copy button copies: the pack's identifier and the value's.
// Identifiers rather than a position, because the worker may have moved the
// sequence between the click and its turn, and an identifier still names the
// value the tester saw - or none (`D98`). Opaque to the view: it holds them
// and never reads them.
export struct ValueKey {
    pack: string,
    value: string,
}

// Which Copy button says "Copied" now, if any (`D121`).
export enum CopiedButton { none, next, last, report }

export component Palette inherits Window {
    // ---- what the window is ------------------------------------------------
    // Every string below is finished text from `nkb-adapters::i18n`. Assembling
    // one here would mean a quoted string in a view, which `ui_guard.rs`
    // refuses - untouchable rule 9, D58.
    in property <string> window-title;

    // ---- the pack band, the only one the compact state shows ----------------
    in property <string> pack;
    in property <string> counter;

    // ---- the value band before the first value ------------------------------
    // Finished text naming the shortcut that sends one. GUI rule 3: a view with
    // data has an empty state, and this band is there from the first frame.
    in property <string> no-value;

    // ---- the next value (UX-GUI-001) ---------------------------------------
    // What the next press sends, shown BEFORE it goes, so the tester does not
    // type blind - a length bomb or an offensive value included. Every string is
    // finished text from `i18n`. Which value it is comes from the core's
    // `Sequence::upcoming`, which a test holds to what the press really does.
    in property <bool> has-next;
    in property <string> next-heading;
    // False at the end of a pack, where the next press only says so and the
    // band is its heading alone.
    in property <bool> next-has-value;
    in property <string> next-name;
    in property <string> next-preview;
    in property <[Marker]> next-markers;

    // ---- the value band ----------------------------------------------------
    // Its heading, now that a second value stands above it.
    in property <string> last-sent-label;
    // Whether the whole value is drawn under the heading, or the heading and
    // the value's name alone (the owner's point 7, 2026-10-07): folded at
    // every start, opened and closed by a click on the heading. Rust holds
    // the switch - the view only draws it.
    in property <bool> last-sent-open;
    // What a click on the heading does, for UI Automation.
    in property <string> last-sent-action;
    callback toggle-last-sent();
    // The report block at the end of the opened band (the owner's point 8,
    // D121): the text the report shortcut copies, from the same function,
    // and its words. Folded at every start - Rust holds this switch too.
    in property <string> report-label;
    in property <string> report-action;
    in property <string> copy-report-action;
    in property <string> report;
    in property <bool> has-report;
    in property <bool> report-open;
    // ⚠️ Declared, not aliases: the block stands in a band behind `if`.
    // Each click only hands on to its callback - one call, no logic.
    callback toggle-report();
    callback copy-report();
    in property <string> value-name;
    // Where the value was typed, read at the press (UX8, `D104`): the program
    // and the kind of control. Never for a value put on the clipboard.
    in property <string> value-sent-to;
    in property <bool> has-sent-to;
    in property <string> value-reference;
    in property <string> value-counts;
    // The value as a person can see it: invisible characters stand in as
    // `nkb_core::preview::MARKER`. `ux-spec.md` 2 calls this the line without
    // which the whole unicode category is unreportable.
    in property <string> value-preview;
    // Said only when the preview is a fragment. Never implied: a fragment
    // presented as the whole is the silence rule 1 forbids.
    in property <string> value-elided;
    // Said only when the preview draws a character the shipped typeface does
    // not guarantee (`D52`, `D66`). What the tester sees of that character
    // depends on the machine, and the tool cannot tell what the machine drew -
    // so it says where its own promise ends.
    in property <string> value-not-guaranteed;
    // What the value is made of, already joined into one line by `i18n`.
    in property <string> value-shape;
    // 🔴 Two switches rather than comparing the strings to "" in the view, and
    // that is not a detour: `ui_guard.rs` refuses a quoted string in a view
    // (untouchable rule 9, D58) and it caught exactly this - the empty literal
    // is not a sentence, but an exception carved into a guard is a door, so the
    // view gets a boolean instead. The same shape as `has-value` above.
    in property <bool> has-elided;
    in property <bool> has-not-guaranteed;
    in property <bool> has-shape;
    in property <[Marker]> markers;

    // ---- the Copy buttons (UX-GUI-003, D98) ---------------------------------
    // One beside the next value and one beside the last value sent: each
    // copies the value drawn in its band, for the tester to paste by hand. The
    // word on both, and what each does in UI Automation's words.
    in property <string> copy-label;
    in property <string> copy-next-action;
    in property <string> copy-last-action;
    // The word a button says for a moment after its copy went through, and
    // which button says it (`D121`, the owner's point 7). Rust sets it from
    // the worker's answer and takes it back two seconds later: the palette's
    // one clock, and it changes nothing the tester chose (`D83`).
    in property <string> copied-label;
    in property <CopiedButton> copied;
    // Which value each copies - set with the band it stands in, from the same
    // view, so a click copies the value on screen. Rust reads them back on the
    // click: the view holds no logic.
    in property <ValueKey> next-key;
    in property <ValueKey> last-key;
    // ⚠️ Declared, not aliases like `open-packs`: both buttons stand in bands
    // behind `if`, and an element behind `if` cannot be named from here. Each
    // click only hands on to its callback - one call, no logic.
    callback copy-next();
    callback copy-last();

    // ---- the arrows that walk the pack without typing (D120) ----------------
    // Their words and what each does, finished text from `i18n`, and whether a
    // step back would move anything: the worker knows where the pack stands,
    // the view only draws it.
    in property <string> back-label;
    in property <string> back-action;
    in property <bool> can-go-back;
    in property <string> skip-label;
    in property <string> skip-action;
    // ⚠️ Declared, not aliases: the arrows stand in a band behind `if`. Each
    // click only hands on to its callback - one call, no logic.
    callback back-one-value();
    callback skip-value();

    // ---- what the tool has to say ------------------------------------------
    in property <[string]> messages;

    // ---- the standing bar --------------------------------------------------
    in property <string> clipboard-mode-label;

    // ---- clipboard mode on and off (UX-GUI-010, D99) ------------------------
    // Clicks and no shortcut: each new global shortcut is a collision in
    // somebody's application (`main.rs`, D71). Chosen on the switch under the
    // hint bar, ended there or on the standing bar, beside the words that say
    // the mode is on - the one way back the compact palette shows. The
    // tester's MODE, not the window's: false while only the window in front is
    // on the clipboard (D72), which is not a mode the tester chose and not one
    // a click could end.
    in property <bool> clipboard-mode-on;
    in property <string> turn-off-label;
    in property <string> turn-off-action;
    // ⚠️ Declared, not an alias: the button stands in a band behind `if`. The
    // click only hands on to its callback - one call, no logic.
    callback turn-off-clipboard();

    // ---- the two switches under the hint bar (the owner's point 2) ---------
    // How values travel (D99) and how a typed one meets the field (D101). Each
    // a label and its ways, finished text from `i18n`, and the way in effect
    // as an index Rust sets from the worker's state: the view does not decide
    // which way is true. A click hands the index of the way chosen to Rust,
    // which knows what each index means.
    in property <string> route-label;
    in property <[string]> route-options;
    in property <int> route-selected;
    callback choose-route(int);
    in property <string> clearing-label;
    in property <[string]> clearing-options;
    in property <int> clearing-selected;
    callback choose-clearing(int);

    // ---- a send in progress (W3, D96, OBS-160) ------------------------------
    // Until this band a long send left the palette showing what it showed
    // before, for minutes, with nothing to say that Escape stops it. Every
    // string is finished text from `i18n`, and the share of the bar is computed
    // and clamped in the worker - the view draws, it does not count.
    in property <bool> sending;
    in property <string> sending-label;
    in property <string> sending-counter;
    in property <float> sending-fraction;
    in property <string> sending-hint;

    // ---- the hint bar ------------------------------------------------------
    in property <[HintRow]> hints;

    // ---- state -------------------------------------------------------------
    // The tester's choice, made with a shortcut or the button in the pack band
    // and never by a timer (D83).
    in property <bool> compact;
    // The button's two words: what a click does in each state (`UX-GUI-004`).
    in property <string> collapse-label;
    in property <string> expand-label;
    // A click on it. The worker owns the switch and remembers it (`D84`), so
    // the click only asks - the same way as the shortcut.
    callback toggle-compact();
    // Whether a value has gone out yet. Before the first one the value band
    // shows its empty state instead of three empty lines and a row of no
    // markers - `ux-spec.md` 5.1.
    in property <bool> has-value;
    // Values go through the clipboard and the tester pastes them. Named after
    // the glossary (`ClipboardMode`), never "degraded": `ux-spec.md` 8 forbids
    // presenting this mode as a failure, in words or otherwise.
    in property <bool> clipboard-mode;
    in property <bool> hints-visible: true;
    // Whether the system permits translucency at all (D53). Separate from
    // `showing` because it is the system's answer, not the palette's state.
    in property <bool> translucency-allowed: true;

    // Asks for the pack window: a click on the pack's name, and Rust invokes
    // the same callback when the shortcut arrives on the worker - so both ways
    // in reach the same Rust on the main thread, and the view holds no handler
    // body.
    callback open-packs <=> header.clicked;
    // What the click does, in the hint bar's words, for UI Automation.
    in property <string> open-packs-label;
    // Asks for the shortcuts window (step 7, K5.5) - a click on the link under
    // the switches. No eleventh global shortcut: each one is a collision in
    // somebody's application (`ux-spec.md` 5.4).
    //
    // ⚠️ Declared, not an alias like `open-packs`: the link stands in a band
    // behind `if`, and an element behind `if` cannot be named from here. The
    // link's own click only hands on to this callback - one call, no logic.
    callback open-shortcuts();
    // The link's words, which are also what the click does.
    in property <string> shortcuts-link;

    title: root.window-title;
    icon: Tokens.app-icon;
    // The colour lives on the frame below, which takes the resting alpha
    // (D53) - a window background would take it too, but one frame for every
    // window means one place that draws the ground.
    background: transparent;
    always-on-top: true;
    width: Tokens.palette-width;
    // The palette follows its own content, in both states. Measured 2026-09-22:
    // Slint does NOT resize a window when what is inside it changes, so
    // without this binding the window keeps whatever size it had - see the
    // header for why there is no floor under it any more (`D110`).
    height: frame.preferred-height;

    // A sentence about clipboard mode, where the switch cannot say it: in the
    // compact state, which shows no switches, and for the window in front,
    // which is not a mode the tester chose and not one the switch shows (D72).
    property <bool> bar-said: root.clipboard-mode && (root.compact || !root.clipboard-mode-on);
    // How to send the first value, until there is one. Expanded only, as the
    // band it replaced was.
    property <bool> nothing-sent-said: !root.compact && !root.has-value;

    frame := WindowFrame {
        dimmed: root.compact && root.translucency-allowed;
        packed: true;

        // The pack and the counter: the palette's title, and at rest the one
        // band besides the status line. A pack name is somebody else's string
        // and can be any length, so the header elides it before the counter
        // and the button give way. A click on it opens the value window, and
        // the mark after it says so with the pointer elsewhere
        // (`UX-GUI-015`).
        header := WindowHeader {
            title: root.pack;
            opens: true;
            action: root.open-packs-label;
            dimmed: root.compact && root.translucency-allowed;
            VerticalLayout {
                alignment: center;
                TextCounter {
                    text: root.counter;
                }
            }
            // Collapse and expand, in BOTH states and in one place
            // (`UX-GUI-004`). The word says what a click does now. Faded while
            // a value goes, like every button here: the worker answers a click
            // between presses, so it would land after the send.
            VerticalLayout {
                alignment: center;
                SmallButton {
                    text: root.compact ? root.expand-label : root.collapse-label;
                    action: root.compact ? root.expand-label : root.collapse-label;
                    enabled: !root.sending;
                    clicked => {
                        root.toggle-compact();
                    }
                }
            }
        }

        // What the next press sends (UX-GUI-001), and the value that went out
        // last - each a band of its own (`components/value_bands.slint`), where
        // the reasons for their shape stand beside it.
        if !root.compact && root.has-next: NextBand {
            heading: root.next-heading;
            has-value: root.next-has-value;
            name: root.next-name;
            preview: root.next-preview;
            markers: root.next-markers;
            copy-label: root.copy-label;
            copy-action: root.copy-next-action;
            copied-label: root.copied-label;
            copied: root.copied == CopiedButton.next;
            sending: root.sending;
            back-label: root.back-label;
            back-action: root.back-action;
            can-go-back: root.can-go-back;
            skip-label: root.skip-label;
            skip-action: root.skip-action;
            copy => {
                root.copy-next();
            }
            back-one-value => {
                root.back-one-value();
            }
            skip-value => {
                root.skip-value();
            }
        }
        if !root.compact: LastSentBand {
            divided: root.has-next;
            label: root.last-sent-label;
            open: root.last-sent-open;
            action: root.last-sent-action;
            has-value: root.has-value;
            name: root.value-name;
            sent-to: root.value-sent-to;
            has-sent-to: root.has-sent-to;
            reference: root.value-reference;
            counts: root.value-counts;
            preview: root.value-preview;
            elided: root.value-elided;
            has-elided: root.has-elided;
            not-guaranteed: root.value-not-guaranteed;
            has-not-guaranteed: root.has-not-guaranteed;
            shape: root.value-shape;
            has-shape: root.has-shape;
            markers: root.markers;
            copy-label: root.copy-label;
            copy-action: root.copy-last-action;
            copied-label: root.copied-label;
            copied: root.copied == CopiedButton.last;
            report-label: root.report-label;
            report-action: root.report-action;
            report-open: root.report-open;
            report: root.report;
            has-report: root.has-report;
            copy-report-action: root.copy-report-action;
            report-copied: root.copied == CopiedButton.report;
            sending: root.sending;
            toggle => {
                root.toggle-last-sent();
            }
            copy => {
                root.copy-last();
            }
            toggle-report => {
                root.toggle-report();
            }
            copy-report => {
                root.copy-report();
            }
        }

        // The two switches and the link to the shortcuts window
        // (`components/switches.slint`, where the reasons for their shape
        // stand). Faded while a value goes, the second also in clipboard mode.
        if !root.compact: SwitchesBand {
            route-label: root.route-label;
            route-options: root.route-options;
            route-selected: root.route-selected;
            route-enabled: !root.sending;
            clearing-label: root.clearing-label;
            clearing-options: root.clearing-options;
            clearing-selected: root.clearing-selected;
            clearing-enabled: !root.sending && !root.clipboard-mode-on;
            shortcuts-link: root.shortcuts-link;
            choose-route(index) => {
                root.choose-route(index);
            }
            choose-clearing(index) => {
                root.choose-clearing(index);
            }
            open-shortcuts => {
                root.open-shortcuts();
            }
        }

        // The keys, in the footer as every window of the product lists them.
        // Hidden in the compact state, which is meant to take little room and
        // no attention - and the keys are muted (D53).
        if root.hints-visible && !root.compact: WindowFooter {
            HintBar {
                rows: root.hints;
            }
        }

        // What the tool has to say, last in the window: whatever comes and
        // goes here moves the bottom edge and nothing above it. In BOTH
        // states - rule 1 of this project forbids a palette that goes quiet
        // because the tester made it small - so every role in it is one the
        // resting state may show (D53): no muted text.
        if root.bar-said || root.sending || root.messages.length > 0 || root.nothing-sent-said: WindowStatus {
            dimmed: root.compact && root.translucency-allowed;
            // Collapsed, the line stands right under the header, whose rule
            // already parts them.
            divided: !root.compact;

            // The standing bar. Permanent by design: a message that disappears
            // stops existing while the limitation stays - `ux-spec.md` 2. The
            // ACCENT tint, not the risk one (D71): clipboard mode is a full
            // route rather than a failure, `ux-spec.md` 8 says so in words, and
            // a bar in the risk colour would say the opposite without any. The
            // way out stands on it while the switch is out of sight (D99).
            if root.bar-said: HorizontalLayout {
                spacing: Tokens.space-2;
                // Centred on the button's row (`slint.md` 2.43).
                VerticalLayout {
                    alignment: center;
                    Pill {
                        text: root.clipboard-mode-label;
                        tint: Tokens.accent;
                    }
                }
                Spacer { }
                if root.clipboard-mode-on: SmallButton {
                    text: root.turn-off-label;
                    action: root.turn-off-action;
                    enabled: !root.sending;
                    clicked => {
                        root.turn-off-clipboard();
                    }
                }
            }

            // A send in progress (W3, D96, OBS-160): until this band a long
            // send left the palette showing what it showed before, for
            // minutes, with nothing to say that Escape stops it. No muted role
            // here, the hint bar's own look included.
            //
            // The counter and the bar in one layout: neither wraps, so the
            // trap of a wrapped text behind an `if` (`slint.md` 2.23) has
            // nothing to bite, and the two come and go as one.
            if root.sending: VerticalLayout {
                spacing: Tokens.space-2;
                HorizontalLayout {
                    spacing: Tokens.space-2;
                    TextBody {
                        text: root.sending-label;
                        overflow: elide;
                    }
                    Spacer { }
                    TextCounter {
                        text: root.sending-counter;
                    }
                }
                ProgressBar {
                    fraction: root.sending-fraction;
                }
            }
            if root.sending: TextBody {
                text: root.sending-hint;
                wrap: word-wrap;
            }

            // Rule 1 of this project: a run that did less than it promised
            // says so, and this is where the palette says it.
            for message in root.messages: TextBody {
                text: message;
                wrap: word-wrap;
            }

            // Before the first value: what to do to send one. GUI rule 3: the
            // palette has an empty state and it is on screen from the first
            // frame.
            if root.nothing-sent-said: TextBody {
                text: root.no-value;
                wrap: word-wrap;
            }
        }
    }
}
